}


def _dig(doc, path):
    """The value at a dotted path, or None when any step is missing or not an object."""
    cur = doc
    for step in path.split("."):
        if not isinstance(cur, dict) or step not in cur:
            return None
        cur = cur[step]
    return cur


def _directive_of(value, where):
    """Classify a dict that is being merged INTO the document: (name, payload) when it is
    a directive object, None when it is a plain object to be merged by depth.

    THE one place a directive is recognised. _apply_directive() has no edge back here, so
    a value INSERTED into an array is never classified — which is what makes "directives
    are interpreted only at merge positions" a property of the call graph rather than a
    rule someone has to remember. An inserted rule may therefore contain any key at all,
    nested arrays included, and is emitted verbatim.
    """
    keys = [k for k in value if isinstance(k, str) and k.startswith("$")]
    if not keys:
        return None
    if len(keys) != len(value) or len(keys) > 1:
        # Mixing a directive with ordinary keys, or two directives in one object: both
        # would need an application order nobody stated, and both are far more likely to
        # be a typo than an intent.
        raise OverrideError(t("at {at}: {name} cannot be combined with other keys in "
                              "the same object", at=where, name=keys[0]))
    if keys[0] not in DIRECTIVES:
        raise OverrideError(t("at {at}: unknown directive {name} — use one of "
                              "{directives}", at=where, name=keys[0],
                              directives=_directive_list()))
    return (keys[0], value[keys[0]])


def _anchor_index(current, match, name, where):
    """Index of the SINGLE element matching `match` by subset equality: every key/value of
    the anchor equals the element's.

    Zero matches or several is an error, never a silent no-op — an overlay that quietly
    does nothing is the failure mode this whole mechanism exists to prevent, and it is
    indistinguishable from a working one until someone reads the emitted document.
    """
    if not isinstance(match, dict):
        raise OverrideError(t("at {at}: {name} needs an object with \"match\" and "
                              "\"values\"", at=where, name=name))
    hits = [i for i, element in enumerate(current)
            if isinstance(element, dict)
            and all(k in element and element[k] == v for k, v in match.items())]
    if len(hits) != 1:
        raise OverrideError(t("at {at}: {name} matched {count} elements, but exactly one "
                              "is required — match: {anchor}", at=where, name=name,
                              count=len(hits),
                              anchor=json.dumps(match, sort_keys=True,
                                                ensure_ascii=False)))
    return hits[0]


def _apply_directive(current, name, payload, where):
    """A NEW list: `current` with one directive applied. `current` is never mutated.

    Every value taken from an overlay is deep-copied IN, so no overlay is aliased into the
    document: _filter_rules()'s in-place edits cannot reach the caller's node objects, and
    a second generate_config() in the same process starts from identical inputs.
    """
    if name in ("$before", "$after"):
        if not isinstance(payload, dict) or set(payload) != set(("match", "values")):
            raise OverrideError(t("at {at}: {name} needs an object with \"match\" and "
                                  "\"values\"", at=where, name=name))
        if not isinstance(payload["values"], list):
            raise OverrideError(t("at {at}: the value of {name} must be an array",
                                  at=where, name=name))
        i = _anchor_index(current, payload["match"], name, where)
        if name == "$after":
            i += 1
        return current[:i] + copy.deepcopy(payload["values"]) + current[i:]
    if not isinstance(payload, list):
        raise OverrideError(t("at {at}: the value of {name} must be an array",
                              at=where, name=name))
    if name == "$replace":
        return copy.deepcopy(payload)
    if name == "$prepend":
        return copy.deepcopy(payload) + current
    return current + copy.deepcopy(payload)             # $append


def _merge(target, overlay, at=""):
    """THE merge implementation: merge `overlay` into the object `target`, in place.

    Objects merge by depth; arrays change ONLY under an explicit directive; a key absent
    from the overlay keeps its current value and its current position. That last clause is
    load-bearing for byte-identity — assigning to a key a dict already has never moves it.

    A bare array where the document already holds one is an error naming the directives
    (a user writing one dns rule to ADD it and silently getting a one-rule DNS section
    would still pass `sing-box check` while misrouting everything), while a bare array at
    a key the document does not have is simply accepted: there is no existing array to be
    ambiguous about. A directive at a key that does not exist is likewise an error, not a
    silent create — a misspelt path is the likeliest user error of all.
    """
    root = _directive_of(overlay, at or t("the top level"))
    if root is not None:
        raise OverrideError(t("at {at}: {name} can only be applied to an array that "
                              "already exists", at=at or t("the top level"),
                              name=root[0]))
    for key, value in overlay.items():
        where = (at + "." + key) if at else key
        if isinstance(value, dict):
            directive = _directive_of(value, where)
            if directive is None:
                if isinstance(target.get(key), dict):
                    _merge(target[key], value, where)
                else:
                    target[key] = copy.deepcopy(value)
            elif isinstance(target.get(key), list):
                target[key] = _apply_directive(target[key], directive[0], directive[1],
                                               where)
            else:
                raise OverrideError(t("at {at}: {name} can only be applied to an array "
                                      "that already exists", at=where,
                                      name=directive[0]))
        elif isinstance(value, list):
            if isinstance(target.get(key), list):
                raise OverrideError(t("at {at}: an existing array must be changed with "
                                      "one of {directives}", at=where,
                                      directives=_directive_list()))
            target[key] = copy.deepcopy(value)
        else:
            target[key] = value                         # scalars, JSON null included


def _load_override():
    """The user's override document, or None when there is none.

    NEVER creates, writes or deletes the file: that is the whole reason a change made
    there survives what a change to config.json does not.

    os.stat comes BEFORE any open(): stat() does not block on a FIFO and open() would, so
    it is this ORDERING — not the S_ISREG test on its own — that stops a device or fifo at
    that path hanging the CLI forever. A symlink resolving to a regular file is fine
    (os.stat follows it and S_ISREG judges the target); users legitimately symlink their
    configuration into a version-controlled directory.

    A whitespace-only or zero-byte file counts as ABSENT, not malformed: `touch
    override.json` expresses "nothing yet", and whitespace cannot encode a typo. Every
    other non-object content stays malformed.

    A DANGLING symlink is malformed, not absent (BC-27/D-17): absent means "the user
    expressed no override", while a link is an affirmative act naming a target, and a
    moved or mistyped target is exactly a typo. ruleset_state() already decides this same
    filesystem shape the same way (see its comment) — one file, one opinion.
    """
    try:
        st = os.stat(str(OVERRIDE_PATH))
    except FileNotFoundError:
        # os.stat FOLLOWS links, which is what makes a link to a regular file work
        # (D-14) and what makes a BROKEN one arrive here dressed as absent. islink is
        # an lstat, so it does not follow; it is false for a path with no entry at all
        # AND for a missing parent component, which is what keeps BC-7 and BC-27's
        # final-component-only boundary intact. It never raises. This arm is entered on
        # every override-less run, so the not-a-link outcome must stay a silent None:
        # one extra lstat, no output, same return value (AC-31, protecting AC-1).
        if os.path.islink(str(OVERRIDE_PATH)):
            # realpath, not readlink: readlink names only the IMMEDIATE target, so on a
            # chain a -> b -> c it names b, not the component that is actually missing.
            # Neither is raise-free: racing either needs write access to root-owned /etc.
            raise OverrideError(t("a symbolic link whose target {target} does not exist",
                                  target=os.path.realpath(str(OVERRIDE_PATH))))
        return None
    except OSError as e:
        raise OverrideError(t("cannot be read ({err})", err=e.strerror or str(e)))
    if not stat.S_ISREG(st.st_mode):
        raise OverrideError(t("not a regular file"))
    try:
        with open(str(OVERRIDE_PATH), "rb") as fh:
            raw = fh.read(OVERRIDE_MAX_BYTES + 1)       # cap the READ, not st_size
    except OSError as e:
        raise OverrideError(t("cannot be read ({err})", err=e.strerror or str(e)))
    if len(raw) > OVERRIDE_MAX_BYTES:
        raise OverrideError(t("larger than {n} bytes", n=OVERRIDE_MAX_BYTES))
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        raise OverrideError(t("not valid UTF-8 text"))
    if not text.strip():
        return None
    try:
        doc = json.loads(text)
    except ValueError as e:
        raise OverrideError(t("not valid JSON ({err})", err=str(e)))
    if not isinstance(doc, dict):
        raise OverrideError(t("the top level must be a JSON object"))
    return doc


def _compose(overlays):
    """The composed document: CONFIG_BASE with each overlay merged in, in order.

    deepcopy, not a reference: _filter_rules() mutates surviving rules in place and
    generate_config() deletes route.rule_set, so anything short of a deep copy would
    corrupt the template for the SECOND call in the same process.
    """
    doc = copy.deepcopy(CONFIG_BASE)
    for overlay in overlays:
        _merge(doc, overlay)
    return doc


def _auto_group_emitted(node_tags):
    """Is the auto-select group present in the document this run emits?

    THE single condition, consumed by _valid_selection(), _runtime_overlay(), cmd_ls() and
    cmd_use() — never re-spelled inline, so "the group exists" cannot acquire a second
    meaning at one of the four call sites.

    Two clauses, and both are load-bearing:
      * at zero nodes the group would have an empty member list, which is a document
        sing-box rejects and a state nothing here may reach;
      * on a host whose nodes.json ALREADY holds a node tagged AUTO_TAG (an upgrade, or a
        share link whose fragment landed there before this build existed), emitting the
        group would put two outbounds with the same tag in the document and fail
        `sing-box check` on the very first `sc reload` after the upgrade. So we emit
        nothing and say nothing; renaming the node heals it.
    """
    return bool(node_tags) and AUTO_TAG not in node_tags


def _valid_selection(active, node_tags):
    """THE judge of "is this selection valid, and what does it become if not".

    Total over every value nodes.json can hold — None, a node tag, AUTO_TAG, a string a
    human typed into the file by hand — and its result is ALWAYS an outbound the same run
    defines. All three places sc picks on the user's behalf (config generation's stale
    repair, `sc add` onto an empty list, `sc rm` of the active node) call it, so none of
    them can form a second opinion.

    Pure: reads no file, writes nothing, prints nothing.

    A selection the user made is never overridden — the first clause returns it unchanged,
    which is what makes an upgrade quiet: an existing host's active node is still valid, so
    nothing moves. Where sc used to pick node_tags[0] (an arbitrary node) it now picks the
    auto-select group, which is strictly better and overrides nobody.
    """
    if active in node_tags:
        return active
    if active == AUTO_TAG and _auto_group_emitted(node_tags):
        return active
    if _auto_group_emitted(node_tags):
        return AUTO_TAG
    return node_tags[0] if node_tags else None


def _ipv6_setting():
    """THE single reader of settings["ipv6"]: exactly one of "on" / "off" / "auto".

    Absence IS "auto" (nothing ever seeds the key), so a host upgrading to this build and
    a fresh install behave identically and _init_files() needs no change. Shaped like
    _saved_clash_port(): an unreadable or malformed settings.json degrades to the default
    silently, because a setting nobody set is not a failure and this must not become a new
    way for `sc` to break on a host whose settings.json is already broken.

    A value that is PRESENT but not one of the three is different — that is a hand-edit
    that did not take effect, so it earns one stderr line naming the file, the key and the
    three accepted values. `sc ipv6 auto` repairs it.

    Reads one file; writes nothing.
    """
    try:
        settings = load_settings()
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return "auto"
    if "ipv6" not in settings:
        return "auto"
    value = settings["ipv6"]
    if value in ("on", "off", "auto"):
        return value
    sys.stderr.write("⚠️  " + t("{path}: ipv6 must be one of on / off / auto — using "
                                "auto", path=SETTINGS_PATH) + "\n")
    return "auto"


def _global_ipv6_iface():
    """(iface, err): the device holding a GLOBAL IPv6 address, and why we could not tell.

    THE predicate behind the `auto` setting and nothing else. "Global" means inside
    2000::/3 — the first three bits of the address are 001 — on a device that is neither
    loopback nor this project's own TUN device. Loopback (::1), link-local (fe80::/10) and
    unique-local (fc00::/7) can never satisfy it arithmetically, and sb-tun is excluded BY
    NAME because a host running this project always carries a link-local address on it: an
    "any IPv6 address" test would report every such host as IPv6-capable.

    A default-route test is deliberately not part of this: it would add a second system
    query and a second failure mode, and `sc ipv6 on|off` already overrides the judgment
    on the rare host where the two would differ.

    An EMPTY file is a legitimate "no IPv6 at all" — (None, None), not an error. `err` is
    set only when the source cannot be read (including a source that is not UTF-8 text at
    all), or when it holds content in which no line at all has the kernel's six-field
    shape. Never raises; prints nothing; the caller decides what a failure means.
    """
    try:
        text = IF_INET6_PATH.read_text()
    except OSError as e:
        return (None, e.strerror or str(e))
    except UnicodeDecodeError:
        # A UnicodeDecodeError is a ValueError, NOT an OSError, so it escapes the clause
        # above and would reach the user as a traceback — the outcome AC-17 forbids and
        # this function's "never raises" contract denies. Unreachable through the real
        # kernel file (always ASCII) and reachable through a repointed IF_INET6_PATH,
        # which is exactly how every fixture drives this function. The codec's own message
        # is untranslated English, so this reuses the existing "unreadable" key (K-9)
        # rather than leaking it into a user-facing sentence.
        return (None, t("unreadable"))
    parsed = False
    for line in text.splitlines():
        # addr(32 hex chars) ifindex prefixlen scope flags device
        fields = line.split()
        if len(fields) != 6:
            continue
        try:
            first = int(fields[0][:2], 16)
        except ValueError:
            continue
        parsed = True
        if (first & 0xE0) != 0x20:          # outside 2000::/3
            continue
        if fields[5] == "lo" or fields[5] == TUN_IFACE:
            continue
        return (fields[5], None)
    if text.strip() and not parsed:
        # Non-empty, and not one line of it is in the shape this kernel file has. Reusing
        # the existing "unreadable" key rather than adding an eleventh string: the outer
        # sentence already says what happened and this fills its cause slot.
        return (None, t("unreadable"))
    return (None, None)


def ipv6_decision():
    """THE definition of the effective IPv6 decision: (setting, suppress, sentence).

    `setting` is what is persisted, `suppress` is what the emitted document does about
    AAAA, and `sentence` is the already-translated evidence for it (None only when
    detection failed, which has already spoken on stderr). Three callers — _dns_overlay(),
    cmd_ipv6() and `sc doctor`'s AAAA row — and no other code re-derives any part of it, so
    the document, what `sc ipv6` says about it and what `sc doctor` reports can never be
    three opinions.

    Detection failure means DO NOT suppress: the two errors are not symmetric. Suppressing
    on a host that can use IPv6 makes IPv6-only destinations unreachable, while not
    suppressing on a host that cannot costs latency the user already has. The assumption is
    stated out loud so it is never silent.

    The address source is read ONLY under `auto`, so `on` and `off` cost exactly one file
    read. Writes no file, issues no request, performs no service-affecting action; its only
    side effect is at most one stderr line.
    """
    setting = _ipv6_setting()
    if setting == "off":
        return (setting, True, t("AAAA queries are answered empty (setting: off)"))
    if setting == "on":
        return (setting, False, t("AAAA queries are resolved normally (setting: on)"))
    iface, err = _global_ipv6_iface()
    if err is not None:
        sys.stderr.write("⚠️  " + t(
            "Could not read this host's IPv6 addresses ({err}) — assuming it has one, so "
            "AAAA queries are resolved normally; set it explicitly with "
            "`sc ipv6 on|off`", err=_plain(err)) + "\n")
        return (setting, False, None)
    if iface is not None:
        return (setting, False, t(
            "AAAA queries are resolved normally (setting: auto — this host has a global "
            "IPv6 address on {iface})", iface=_plain(iface)))
    return (setting, True, t("AAAA queries are answered empty (setting: auto — this host "
                             "has no global IPv6 address)"))


def _aaaa_rule(suppress):
    """THE one place the predefined AAAA rule dict is spelled, for one decision.

    Pure: no I/O, no print, never raises, and it does NOT call ipv6_decision() — the caller
    passes the decision in. That is what lets `sc doctor` ask "does the document carry this
    decision?" as a membership test against the one authored rule, without a second
    ipv6_decision() call and without re-spelling the literal a second time (a positional
    index into the overlay would silently check the wrong rule the day a second one is
    prepended).
    """
    return {"action": "predefined", "rcode": "NOERROR",
            "query_type": ([28, 64, 65] if suppress else [64, 65])}


def _dns_overlay():
    """THE one place the IPv6 decision reaches the emitted document.

    $prepend on dns.rules — an existing directive on an array CONFIG_BASE always defines,
    so this can never raise and needs no anchor a later edit to the base could break.

    Index 0 is the whole point: it is the one position that precedes BOTH clash_mode rules
    and every rule whose server is reached through a node outbound, which is what makes the
    suppression mode-independent (a user switching to `global` because things are broken
    must not get the stall back) and node-independent. The rule carries no rule_set key, so
    _filter_rules() keeps it on exactly the degraded host that needs it most.

    Types 64 and 65 (SVCB / HTTPS) are answered in BOTH states: that is what the rule this
    replaces already did, and moving it must not change it. Only 28 (AAAA) is conditional.
    An empty NOERROR is the answer, never NXDOMAIN — NXDOMAIN would poison the negative
    cache for the whole name, its A record included.
    """
    return {"dns": {"rules": {"$prepend": [_aaaa_rule(ipv6_decision()[1])]}}}


# THE definition of the telemetry name list — one tuple, two consumers (_telemetry_overlay()
# and cmd_telemetry()), no third derivation and no per-consumer subset. A tuple for the same
# reason RULESET_FILES is one: this order IS the emitted domain_suffix order and must not
# depend on anything else.
#
# ADMISSION CRITERION, both clauses required. A name is here only if (1) its sole function is
# carrying usage, diagnostic, crash or advertising-identifier data to a vendor, AND (2)
# blocking it disables no user-visible function of the product it belongs to. No update,
# activation, licensing, authentication, push-delivery, CDN-content, captcha or
# security-feature endpoint qualifies, whatever its data-collection role — which is why
# analytics.google.com (also serves the Analytics console UI), omtrdc.net (Adobe Target
# delivers page content), googletagmanager.com, settings-win.data.microsoft.com,
# connect.facebook.net, clients2.google.com and the push hosts (msg.umeng.com,
# mtalk.google.com) are deliberately ABSENT. Do not add a name without applying both clauses.
#
# Each entry is a dotless domain_suffix: in sing-box 1.13.15 domain_suffix is label-boundary
# aware, so "example.com" matches the apex and every subdomain at any depth, case
# insensitively, and does NOT match "notexample.com". A LEADING DOT would silently leave the
# apex resolvable — never write one.
TELEMETRY_NAMES = (
    # class 1 — desktop-OS diagnostics
    "telemetry.microsoft.com",          # Microsoft: the Windows diagnostics/error-reporting subtree (watson. crash uploads, oca. crash analysis, sqm. usage counters). Blocking loses crash-report submission only.
    "vortex.data.microsoft.com",        # Microsoft: the Connected User Experiences and Telemetry (DiagTrack) diagnostic-data upload endpoint. Nothing user-visible depends on it.
    "vortex-win.data.microsoft.com",    # Microsoft: the Windows-specific sibling of the above. Listed by host, not as data.microsoft.com — that apex also carries settings-win., which is settings/update policy and fails clause 2.
    "metrics.ubuntu.com",               # Canonical: the endpoint ubuntu-report POSTs the installer/hardware survey to. Sole function is measurement; nothing on the host waits on it.
    "daisy.ubuntu.com",                 # Canonical: the whoopsie/Apport crash-report submission endpoint. The crash itself and every desktop function are unaffected.
    # class 2 — browser telemetry
    "incoming.telemetry.mozilla.org",   # Mozilla: the Firefox Telemetry ping submission endpoint (main, event and health pings). Firefox loads no content from it.
    # class 3 — dominant global analytics / crash-reporting SDKs
    "google-analytics.com",             # Google: Google Analytics hit collection (/collect, /g/collect); the suffix also covers www. and ssl.. Sites load it asynchronously and gate no content on it.
    "app-measurement.com",              # Google: the Firebase / Google Analytics for Firebase mobile SDK measurement upload host. Carries app usage events and the advertising identifier; serves no app content.
    "crashlytics.com",                  # Google: Firebase Crashlytics crash and session reporting (reports., e., settings., firebase-settings.). Blocking disables crash reporting only.
    "demdex.net",                       # Adobe: Experience Cloud ID / Audience Manager — cross-site visitor identification and segment sync; delivers no page content. Clause 2 clears it ONLY because the denial is IMMEDIATE (~4 ms NXDOMAIN, measured): a page whose personalisation flow calls this identity service falls back at once instead of waiting out a pre-hiding timeout. A dropped or black-holed query here WOULD break page rendering, which is why this list never drops a query.
    "scorecardresearch.com",            # Comscore: audience-measurement beacons (sb.scorecardresearch.com/b). Its entire published purpose is panel measurement; it returns no content a page uses.
    # class 4 — dominant domestic analytics SDKs
    "hm.baidu.com",                     # Baidu: Baidu Tongji (百度统计) web analytics — the hm.js collector and its hm.gif beacon. Loaded asynchronously; nothing is gated on it.
    "cnzz.com",                         # Umeng+/CNZZ (Alibaba): the CNZZ web-analytics counter and log collection domain (z*., c., w.). Clause 2 clears the whole apex on ONE claim — that the site-owner console lives on umeng.com, not here — so a CNZZ apex that ever served a console page would fail clause 2 and belong off this list; that claim, not the payload, is what admits it.
    "mmstat.com",                       # Alibaba: the group's usage/behaviour logging domain (log., gm., sre. and siblings). The whole domain is beacon collection; no Taobao/Tmall page content is served from it.
    "ulogs.umeng.com",                  # Umeng (Alibaba): the U-App analytics SDK's log upload host. Listed by host, NOT as umeng.com — that apex also carries U-Push message delivery and the vendor's console, both of which fail clause 2.
    "tracking.miui.com",                # Xiaomi: MIUI's system usage/analytics upload host. Carries no update, activation or push traffic — those are separate MIUI hosts.
    "data.mistat.xiaomi.com",           # Xiaomi: the MiStat statistics SDK's data upload host, used by Xiaomi's own applications for usage counters. Blocking removes reporting only.
)


def _telemetry_setting():
    """THE single reader of settings["telemetry"]: exactly "block" or "allow".

    Absence IS "block" (nothing ever seeds the key), so a host upgrading to this build and a
    fresh install behave identically and _init_files() needs no change. Shaped like
    _ipv6_setting(), guard tuple included: an absent, unreadable or non-JSON settings.json
    degrades to the default silently, because a setting nobody set is not a failure and this
    must not become a new way for `sc` to break on a host whose settings.json is already
    broken.

    THE SILENCE HAS TWO HOLES, both measured, both pre-existing, and neither widened here:
      * a settings.json that is not valid UTF-8 raises through this guard, because
        Path.read_text() raises UnicodeDecodeError and that is a ValueError, NOT an
        OSError. `sc ipv6 show` behaves identically on the same file — it is the same guard
        tuple and the same hole (R-25's family owns it), not something this list introduced.
      * cmd_telemetry()'s SET form does not reach this function's guard at all: it calls
        load_settings() directly, exactly as cmd_ipv6() does, and load_settings() is a bare
        json.loads(read_text()), so `sc telemetry block` on a host whose settings.json is
        not valid JSON raises a traceback.
    So "no traceback" is scoped to THIS function against an absent / unreadable / non-JSON
    file, and no user-facing text anywhere claims `sc telemetry` is traceback-free.

    A value that is PRESENT but not one of the two is different — a hand-edit that did not
    take effect, so it earns one stderr line naming the file, the key and the two accepted
    values. `sc telemetry block` repairs it.

    There is deliberately no telemetry_decision() sibling: unlike IPv6 there is no
    host-derived input, so the setting IS the decision and a second function would be a
    second name for one value.

    Reads one file; writes nothing; performs no service-affecting action.
    """
    try:
        settings = load_settings()
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return "block"
    if "telemetry" not in settings:
        return "block"
    value = settings["telemetry"]
    if value in ("block", "allow"):
        return value
    sys.stderr.write("⚠️  " + t("{path}: telemetry must be block or allow — using block",
                                path=SETTINGS_PATH) + "\n")
    return "block"


def _telemetry_overlay():
    """THE one place the telemetry name list reaches the emitted document.

    $before on an object anchor — the capability the composition layer already has — puts a
    single `predefined` rule immediately ahead of the first clash_mode rule. That position
    is the contract, not a detail: dns.rules has two layers, rules that ANSWER here and
    rules that CHOOSE a resolver, and clash_mode belongs to the second. Placed after those
    two rules the reject rule is absent in exactly `global` and `direct` — measured: a
    listed name then returns NOERROR with a record AND the query is recorded upstream, which
    is the leak this feature exists to prevent. Placed here it is after the hosts_dns rule
    (so `sc`'s own DoH bootstrap keeps answering, and extending the list can never break it)
    and before every rule whose server is reached through a node outbound.

    THREE KEYS, EXACTLY, AND `answer` IS NOT ONE OF THEM. All three were measured against
    1.13.15: `predefined` + rcode NXDOMAIN with a NON-EMPTY `answer` passes `sing-box check`
    and emits a self-contradictory NXDOMAIN carrying one record; an OMITTED rcode silently
    means NOERROR; a lowercase "nxdomain" is a hard `check` failure. So rcode is written
    explicitly and uppercase, and `answer` is omitted entirely.

    No rule_set key, so _filter_rules() keeps it on exactly the degraded host that has no
    other protection. No `reject` action anywhere: `reject` answers REFUSED or nothing at
    all, and a silently dropped query is indistinguishable from the broken network this
    project must not imitate.

    Under `allow` this returns the EMPTY document, which _merge() treats as a no-op by
    iteration — so dns.rules is byte-identical to the pre-T-17 build and generate_config()
    needs no branch.
    """
    if _telemetry_setting() != "block":
        return {}
    return {"dns": {"rules": {"$before": {
        "match": {"clash_mode": "Global"},
        "values": [{"action": "predefined", "rcode": "NXDOMAIN",
                    "domain_suffix": list(TELEMETRY_NAMES)}],
    }}}}


def _runtime_overlay(nodes, active, report):
    """The one carrier of run-time content, expressed as an overlay so that the shipped
    path exercises _merge() on every single run rather than only when a user has written
    an override.

    Each value lands on a key CONFIG_BASE already defines, which is what preserves its
    emitted position: outbounds and route.rule_set are $replace'd, and
    external_controller reaches its slot by depth-merge over an existing scalar. The
    selector's own nested "outbounds" array sits INSIDE a directive payload, so it is
    copied verbatim and never re-interpreted.

    RULES_DIR and CLASH_PORT are read here, at call time. TUN_IFACE deliberately is not:
    it is a compile-time constant and CONFIG_BASE names it directly.
    """
    node_tags = [n["tag"] for n in nodes]
    auto = _auto_group_emitted(node_tags)
    # The auto-select group. Every key is emitted explicitly, including url: this binary
    # compiles in a generate_204 default, and stating it here is what stops a future
    # binary's default from silently moving the probe. https (not http) on purpose — the
    # failure this whole feature exists for is a TLS handshake that hangs, and a
    # plain-HTTP 204 would score exactly that node as healthy. interval is the upper bound
    # on unattended failover latency; tolerance keeps the group from re-selecting on
    # jitter alone. interrupt_exist_connections is deliberately ABSENT: on a group the
    # switch is automatic and can be caused by a 51 ms improvement, so an inbound
    # connection is left to drain on the old member — and sing-box interrupts sc's own
    # internal connections (the DoH transport that carries remote_dns) on re-selection
    # regardless of this option, so DNS still follows the healthy node.
    group = {
        "type": "urltest",
        "tag": AUTO_TAG,
        "outbounds": list(node_tags),
        "url": "https://www.gstatic.com/generate_204",
        "interval": "3m",
        "tolerance": 50,
        "idle_timeout": "30m",
    }
    selector = {
        "type": "selector",
        "tag": "proxy",
        "outbounds": ([AUTO_TAG] if auto else []) + node_tags + ["direct"],
        # Through the one judge, so `default` is always an element of the array above.
        "default": _valid_selection(active, node_tags) or "direct",
        "interrupt_exist_connections": True,
    }
    return {
        # The group sits immediately after the selector and before the nodes, so at zero
        # nodes this expression collapses to exactly what it was before this feature
        # existed — the fresh-install document is byte-identical by construction.
        "outbounds": {"$replace":
                      [selector] + ([group] if auto else []) + nodes
                      + [{"type": "direct", "tag": "direct"}]},
        "route": {"rule_set": {"$replace": [
            {"tag": tag, "type": "local", "format": "binary",
             "path": str(RULES_DIR / fname)}
            for tag, fname, status in report if status == "usable"
        ]}},
        "experimental": {
            "clash_api": {"external_controller": f"127.0.0.1:{CLASH_PORT}"},
        },
    }



# ============ Config generation ============

def _config_digest():
    """sha256 hex of config.json AS IT IS ON DISK, or None when it cannot be read.

    THE single definition of "which document is this" for drift purposes: the record
    writer and the drift check both call it, so the two can never form different opinions
    about what "unchanged" means. Hashing the FILE rather than the in-memory text is what
    makes the record locale-independent and makes "what was recorded" and "what is on
    disk" the same question by construction.

    Deliberately separate from ruleset_state(), which answers a different question about a
    different file and must not grow a second job.
    """
    digest = hashlib.sha256()
    try:
        with CFG_PATH.open("rb") as fh:
            while True:
                chunk = fh.read(65536)
                if not chunk:
                    break
                digest.update(chunk)
    except OSError:
        return None
    return digest.hexdigest()


def _record_generated():
    """Record what sc just installed. Called ONLY after a successful _write_private() of
    config.json, so the record can never claim a document that never reached disk.

    Best-effort, in the shape _resolve_clash_port() already uses for a derived value: the
    realistic causes of a failure here (ENOSPC, EROFS) would have failed the config.json
    write one line earlier, and an absent record degrades to "unknown" — never to a false
    drift warning. The record is a 65-byte hex digest and holds no credential bytes, and
    it still goes through the one writer at 0600, which costs nothing and settles the
    question.
    """
    digest = _config_digest()
    if digest is None:
        return
    try:
        _write_private(STATE_PATH, digest + "\n")
    except OSError:
        pass


def _drift_state():
    """Has config.json drifted from what sc last generated? True / False / None.

    THE judgement, with ONE home: True drifted, False matches, None unknown. Both display
    sites read it — `generate_config()`'s warning below and `sc config` — so a second
    opinion about what "unchanged" means is not expressible.

    None covers every case in which the question cannot be answered: no record, a record
    that cannot be read (OSError) or is not UTF-8 (a UnicodeDecodeError is a ValueError,
    not an OSError), a record that is empty after stripping, or a config.json that
    _config_digest() could not read. NO record means UNKNOWN, never drifted: every host
    upgrading from a build before the record existed has none, and a warning that fires on
    100% of installs at first upgrade teaches people to ignore exactly the warning that has
    to stay loud.

    Reads two files; writes nothing, and never logs the document's content.
    """
    try:
        recorded = STATE_PATH.read_text().strip()
    except (OSError, ValueError):
        return None
    if not recorded:
        return None
    current = _config_digest()
    if current is None:
        return None
    return current != recorded


def _warn_drift():
    """One stderr line when config.json on disk is not what sc last generated.

    The WARNING RENDERER over _drift_state() and nothing more — the judgement itself lives
    there. `not _drift_state()` is false for both False (matches) and None (unknown), so
    the silence on an unknown state is the same silence as before.

    Loud, and never blocking: a drifted host must still be able to switch nodes and re-run
    install.sh, so a diagnostic may not lock the user out. Nothing is backed up either —
    that would put a second copy of credential bytes on disk to solve a problem the
    override file solves properly.

    Reads config.json into memory only; writes nothing, and never logs its content.
    """
    if not _drift_state():
        return
    sys.stderr.write("⚠️  " + t(
        "{path} was modified outside sc — those changes are about to be replaced; put "
        "them in {override} to keep them.",
        path=CFG_PATH, override=OVERRIDE_PATH) + "\n")


def generate_config():
    # The override is parsed FIRST, before any state is read or written, so an unreadable
    # or malformed one costs the user nothing at all. A merge-time fault still lands after
    # the active-node rewrite below, because that side effect and its ordering are pinned
    # behaviour; it is idempotent and touches neither config.json nor the service.
    #
    # The wrapper states WHOSE document is being handled here. It is the call structure,
    # not a flag at each raise site, that decides which path main() names — so a fault in
    # an overlay sc itself authored can never be reported as a fault in the user's file.
    try:
        override = _load_override()
    except OverrideError as e:
        e.path = OVERRIDE_PATH
        raise

    nodes_data = load_nodes()
    nodes = nodes_data["nodes"]
    active = nodes_data.get("active")

    # The ONE rule-set query. The same report drives the definition list and, through the
    # composed document, both reference arrays — so a tag can never be referenced without
    # being defined.
    report = ruleset_report()

    # The stale-selection repair, and the only writer of nodes.json in this function.
    # Persist ONLY when the judge returns something other than what was loaded: an
    # unconditional save would rewrite nodes.json on every single regeneration, and
    # `active` being the auto-select group is a valid selection the judge returns
    # unchanged, not something to repair away.
    node_tags = [n["tag"] for n in nodes]
    repaired = _valid_selection(active, node_tags)
    if repaired != active:
        active = repaired
        nodes_data["active"] = active
        save_nodes(nodes_data)

    # sc's own overlays first, then the user's — the user's document is still applied
    # LAST and still through the ONE _merge(), so the emitted bytes do not depend on it
    # being a third element of this list rather than a separate call. What the separate
    # call buys is provenance: two failure sources now have two code sites.
    config = _compose([_runtime_overlay(nodes, active, report), _dns_overlay(),
                       _telemetry_overlay()])
    if override is not None:
        try:
            _merge(config, override)
        except OverrideError as e:
            e.path = OVERRIDE_PATH
            raise

    # NOT schema validation — that is `sing-box check`'s job. Exactly the three arrays the
    # block below indexes into, so an override that turns one of them into a scalar earns
    # a sentence rather than a traceback. It cannot fire when there is no override — every
    # overlay sc composes leaves all three arrays — which is why this raise, too, names the
    # user's document.
    for at in ("dns.rules", "route.rules", "route.rule_set"):
        if not isinstance(_dig(config, at), list):
            failure = OverrideError(t("at {at}: this must stay an array", at=at))
            failure.path = OVERRIDE_PATH
            raise failure

    # Degrade per file: drop every rule that references a rule-set the composed document
    # does not DEFINE, in BOTH rule arrays. The tags come from the document rather than
    # from usable_tags(report) — identical by construction when there is no override,
    # since the overlay builds route.rule_set from exactly the usable entries of the same
    # report, and it is what stops a user-defined rule-set having every rule referencing
    # it silently deleted. Computed BEFORE the empty-case deletion below.
    defined = set(d.get("tag") for d in config["route"]["rule_set"]
                  if isinstance(d, dict))
    if not config["route"]["rule_set"]:
        del config["route"]["rule_set"]     # an absent optional field beats an empty one
    config["dns"]["rules"] = _filter_rules(config["dns"]["rules"], defined)
    config["route"]["rules"] = _filter_rules(config["route"]["rules"], defined)
    _warn_degraded(report)
    _warn_drift()       # stderr only, and BEFORE the file it warns about is replaced

    # Ordering versus `sing-box check` is unchanged: the config is written first.
    try:
        _write_private(CFG_PATH, json.dumps(config, indent=2, ensure_ascii=False))
    except OSError as e:
        sys.stderr.write("⚠️  " + t("Could not write {path}: {err}",
                                    path=CFG_PATH, err=_plain(e.strerror or str(e))) + "\n")
        return False
    _record_generated()     # only after the document really reached disk

    r = subprocess.run([SB_BIN, "check", "-c", str(CFG_PATH)],
                       capture_output=True, text=True)
    if r.returncode != 0:
        sys.stderr.write("⚠️  " + t("Config check failed:\n{stderr}", stderr=r.stderr) + "\n")
        return False
    return True

def restart_service():
    """Restart sing-box. True iff the init system's restart command reported success.

    Neither init system ⇒ nothing was asked, so nothing failed: True (an arm nobody reads).
    Stays check=False: raising into reload_or_restart's six callers is not this one's job.
    """
    if SYSTEMD:
        r = subprocess.run(["systemctl", "restart", SERVICE], check=False)
    elif OPENRC:
        r = subprocess.run(["rc-service", SERVICE, "restart"], check=False)
    else:
        return True
    return r.returncode == 0


def reload_or_restart():
    if not generate_config():
        return False
    restart_service()
    return True


# ============ Clash API ============

def clash_api(method, path, data=None, port=None):
    """Ask the local Clash API one question. Returns a JSON object or None, never raises one of the
    three exception families its own body raises — OSError, ValueError, http.client.HTTPException.
    Those three are caught rather than their leaves (timeout, refusal, bad status, bad bytes, bad
    JSON, short body) or a bare Exception, because a leaf enumeration needs re-patching every time
    a sibling escapes. An empty 2xx body is {}; a body that is not a JSON object is None; only a
    pathological loopback body can still raise (RecursionError / MemoryError).
    port=None keeps every call site on the port main() resolved; `sc doctor` passes the persisted
    port explicitly, because it never resolves (and so never persists) one of its own."""
    url = f"http://127.0.0.1:{port or CLASH_PORT}" + path
    body = json.dumps(data).encode() if data is not None else None
    req = urllib.request.Request(url, data=body, method=method)
    if body:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=3) as r:
            text = r.read().decode()
            answer = json.loads(text) if text else {}
    except (OSError, ValueError, http.client.HTTPException):
        return None
    return answer if isinstance(answer, dict) else None


def is_running():
    if SYSTEMD:
        return subprocess.run(["systemctl", "is-active", "--quiet", SERVICE]).returncode == 0
    elif OPENRC:
        return subprocess.run(["rc-service", SERVICE, "status"],
                               capture_output=True).returncode == 0
    return False


def stored_delays(port=None):
    """THE reader of "what delay does the running sing-box report per outbound".

    Returns (delays, current): delays maps an outbound tag to its last stored round-trip
    in ms, current is the node the auto-select group is on right now (or None).

    It READS; it measures nothing. The Clash API serves a url-test *history* — a value the
    process already had, produced by the auto-select group's own probing. A node nobody has
    probed simply has no entry, which is a fact to render, never one to fabricate.

    Prints nothing, writes nothing, issues at most ONE GET and never a PUT/PATCH/DELETE,
    takes no `sc ls`-specific argument — so `sc doctor` can call it later unchanged. The
    is_running() guard is INSIDE the function so every future caller inherits it: on a
    stopped host there is no request at all and therefore no 3 s wait.

    Every shape check is an isinstance test and there is no try/except: a malformed body
    must not reach a traceback, and a bare except would hide a real defect just as well as
    it hides a malformed body. bool is excluded explicitly — it is an int in Python, and
    `True` is not a delay.
    """
    if not is_running():
        return {}, None
    body = clash_api("GET", "/proxies", port=port)
    delays = {}
    current = None
    if not isinstance(body, dict):
        return delays, current
    proxies = body.get("proxies")
    if not isinstance(proxies, dict):
        return delays, current
    for tag, entry in proxies.items():
        if not isinstance(entry, dict):
            continue
        history = entry.get("history")
        if isinstance(history, list) and history:
            last = history[-1]
            if isinstance(last, dict):
                ms = last.get("delay")
                if isinstance(ms, int) and not isinstance(ms, bool) and ms > 0:
                    delays[tag] = ms
        if tag == AUTO_TAG:
            now = entry.get("now")
            if isinstance(now, str) and now:
                current = now
    return delays, current


# ============ Helpers ============

def _resolve_node(spec):
    nodes_data = load_nodes()
    nodes = nodes_data["nodes"]
    if not nodes:
        sys.exit(t("Error: no nodes added yet — use `sc add <link>` first"))
    try:
        idx = int(spec)
        if 1 <= idx <= len(nodes):
            return nodes_data, nodes[idx - 1]
    except ValueError:
        pass
    for n in nodes:
        if n["tag"] == spec:
            return nodes_data, n
    matches = [n for n in nodes if spec.lower() in n["tag"].lower()]
    if len(matches) == 1:
        return nodes_data, matches[0]
    if len(matches) > 1:
        names = "\n  ".join(n["tag"] for n in matches)
        sys.exit(t("Error: '{spec}' matches multiple nodes:\n  {names}", spec=spec, names=names))
    sys.exit(t("Error: no node matches '{spec}' (try `sc ls`)", spec=spec))


def _unique_tag(tag, existing):
    # The reserved tags are rejected by the minter itself rather than by its caller, so
    # "no node ever carries a tag sc emits" is a property of the one place tags are made
    # and a future second caller inherits it. A share link whose fragment is `auto`
    # therefore becomes `auto #2` instead of colliding with the auto-select group.
    if tag not in existing and tag not in RESERVED_TAGS:
        return tag
    i = 2
    while f"{tag} #{i}" in existing:
        i += 1
    return f"{tag} #{i}"


# ============ Commands ============

def cmd_ls(args):
    nodes_data = load_nodes()
    nodes = nodes_data["nodes"]
    active = nodes_data.get("active")
    if not nodes:
        print(t("(no nodes — use `sc add <link>` to add)"))
        return
    # One call, one request, before anything is printed. `-` is the unknown marker: a node
    # nobody has probed has no stored delay, and `0` would read as "instant" while a blank
    # cell reads as "zero".
    delays, current = stored_delays()

    def _delay_cell(tag):
        return f"{delays[tag]} ms" if tag in delays else "-"

    # The delay column is appended LAST, so no existing column's width or position moves
    # and `sc use <n>` sees the same index numbers it always did.
    print(f"{t('ls.idx'):>4}  {t('ls.active'):2}  {t('ls.type'):10}  {t('ls.name'):30}  {t('ls.address'):25}"
          f"  {t('Delay'):>9}")
    if _auto_group_emitted([n["tag"] for n in nodes]):
        # The auto-select group, first and WITHOUT an index number — it is not a node and
        # must not enter _resolve_node()'s index space. Its address cell names the node it
        # is on right now, which is the one place `sc` states that fact.
        auto_addr = f"→ {current}" if current else "-"
        auto_marker = "●" if active == AUTO_TAG else " "
        print(f"{'':>4}  {auto_marker:2}  {'urltest':10}  {AUTO_TAG:30}  {auto_addr[:25]:25}"
              f"  {_delay_cell(AUTO_TAG):>9}")
    for i, n in enumerate(nodes, 1):
        marker = "●" if n["tag"] == active else " "
        addr = f"{n['server']}:{n['server_port']}"
        print(f"{i:>4}  {marker:2}  {n['type']:10}  {n['tag'][:30]:30}  {addr[:25]:25}"
              f"  {_delay_cell(n['tag']):>9}")


def cmd_now(args):
    nodes_data = load_nodes()
    print(nodes_data.get("active") or t("(none)"))


def cmd_use(args):
    # The reserved tag is decided BEFORE _resolve_node() is consulted, so a node named
    # `auto-jp` can never swallow `sc use auto` through that function's substring
    # fallback. The extra read costs only the run in which the user typed the reserved
    # word, and nothing else about this command moves.
    tag = None
    if args.spec == AUTO_TAG:
        nodes_data = load_nodes()
        if _auto_group_emitted([n["tag"] for n in nodes_data["nodes"]]):
            tag = AUTO_TAG
    if tag is None:
        # `sc use auto` on a host with no nodes, or on one whose own node is tagged
        # `auto`, lands here — i.e. on exactly the behaviour of before this feature.
        nodes_data, node = _resolve_node(args.spec)
        tag = node["tag"]
    nodes_data["active"] = tag
    save_nodes(nodes_data)
    if is_running():
        r = clash_api("PUT", "/proxies/proxy", {"name": tag})
        if r is not None:
            print(t("Switched to: {tag}", tag=tag))
            return
    if reload_or_restart():
        print(t("Switched to: {tag} (service restarted)", tag=tag))


def cmd_add(args):
    if not args.url:
        sys.exit(t("Usage: sc add '<vless://...|vmess://...|trojan://...|ss://...|hysteria2://...|tuic://...>'\nHint: wrap the share link in single quotes"))
    try:
        outbound = parse_share_url(args.url)
    except Exception as e:
        sys.exit(t("Error: {e}", e=e))
    nodes_data = load_nodes()
    existing = {n["tag"] for n in nodes_data["nodes"]}
    outbound["tag"] = _unique_tag(outbound["tag"], existing)
    nodes_data["nodes"].append(outbound)
    if not nodes_data.get("active"):
        # Through the one judge rather than "the node just added": on a fresh install the
        # first `sc add` therefore selects the auto-select group, so failover is on by
        # default without any host's existing selection being touched.
        nodes_data["active"] = _valid_selection(
            nodes_data.get("active"), [n["tag"] for n in nodes_data["nodes"]])
    save_nodes(nodes_data)
    if reload_or_restart():
        print(t("Added: {tag} ({type} → {server}:{port})",
                tag=outbound["tag"], type=outbound["type"],
                server=outbound["server"], port=outbound["server_port"]))
    else:
        print(t("Added: {tag} (⚠️ config check failed — see `sc log`)", tag=outbound["tag"]))


def cmd_rm(args):
    nodes_data, node = _resolve_node(args.spec)
    nodes_data["nodes"] = [n for n in nodes_data["nodes"] if n["tag"] != node["tag"]]
    if nodes_data.get("active") == node["tag"]:
        # Same judge as everywhere else — never node_tags[0] again.
        nodes_data["active"] = _valid_selection(
            None, [n["tag"] for n in nodes_data["nodes"]])
    save_nodes(nodes_data)
    reload_or_restart()
    print(t("Removed: {tag}", tag=node["tag"]))


def cmd_on(args):
    if SYSTEMD:
        subprocess.run(["systemctl", "enable", "--now", SERVICE], check=False)
    elif OPENRC:
        subprocess.run(["rc-update", "add", SERVICE, "default"], check=False)
        subprocess.run(["rc-service", SERVICE, "start"], check=False)
    settings = load_settings()
    settings["default_tun"] = True
    save_settings(settings)
    print(t("sing-box started + boot autostart enabled"))


def cmd_off(args):
    if SYSTEMD:
        subprocess.run(["systemctl", "disable", "--now", SERVICE], check=False)
    elif OPENRC:
        subprocess.run(["rc-service", SERVICE, "stop"], check=False)
        subprocess.run(["rc-update", "del", SERVICE, "default"], check=False)
    settings = load_settings()
    settings["default_tun"] = False
    save_settings(settings)
    print(t("sing-box stopped + boot autostart disabled"))


def cmd_status(args):
    print(t("=== Service status ==="))
    if SYSTEMD:
        subprocess.run(["systemctl", "status", "--no-pager", "-n", "5", SERVICE])
    elif OPENRC:
        subprocess.run(["rc-service", SERVICE, "status"])
    print("\n" + t("=== TUN interface ==="))
    subprocess.run(["ip", "-br", "addr", "show", TUN_IFACE])
    # Above is_running(): a stopped service is exactly where a stale rule-set matters.
    print("\n" + t("=== Rule-sets ==="))
    for _tag, fname, status, _digest, _size, mtime in ruleset_states():
        print("%-20s %s, %s" % (fname, _status_text(status), _age_text(mtime)))
    if is_running():
        nodes_data = load_nodes()
        print("\n" + t("=== Current node ==="))
        print(nodes_data.get("active") or t("(none)"))
        r = clash_api("GET", "/configs")
        print("\n" + t("=== Route mode ==="))
        print((r or {}).get("mode", t("(unavailable)")))
        print("\n" + t("=== Clash API ==="))
        print(f"127.0.0.1:{CLASH_PORT}")
        print("\n" + t("=== Egress IP ==="))
        try:
            print(_egress_ip())
        except Exception as e:
            print(t("(error: {e})", e=e))


# ============ doctor ============
# One pass, one screen, nine facts, in CAUSAL order: no section is printed before a
# section whose failure would explain it (binary and rule-sets above the config check,
# the config check above the AAAA decision it is judged against, both above the service,
# the service above TUN / Clash API, the Clash rows above the node delays and the lookup,
# and all of them above egress; file permissions last, because a wrong mode explains no
# other row). Nothing here forms a second opinion — every fact comes from the function
# that already owns that judgment.
#
# READ-ONLY, absolutely. `doctor` runs when the machine is already broken, so it must not
# destroy the evidence: it writes no file, touches no service, and main() keeps it off
# _init_files() / _resolve_clash_port(), the two writers on the shared start-up path.

DOCTOR_OK, DOCTOR_UNKNOWN, DOCTOR_PROBLEM = 0, 1, 2     # ordered: OK < UNKNOWN < PROBLEM
# Values are translation KEYS, resolved at print time — LANG is assigned in main(), after
# import, so a pre-rendered table would freeze English (same reason as _status_text()).
DOCTOR_MARK = {DOCTOR_OK: "OK", DOCTOR_UNKNOWN: "UNKNOWN", DOCTOR_PROBLEM: "PROBLEM"}
DOCTOR_EXIT = {DOCTOR_OK: 0, DOCTOR_UNKNOWN: 2, DOCTOR_PROBLEM: 1}
DOCTOR_MSG_LINES = 5        # at most this many verbatim lines of a quoted list


def _plain(text):
    """Foreign text (a tool's output, an exception message) made safe for the non-TTY
    output contract: CR and ESC removed, trailing whitespace stripped. Never abridges.

    Everything doctor prints that it did not write itself goes through here, so "no \\r and
    no ESC in a redirected report" is a property of this code rather than a hope about
    other programs' colour detection.

    A complete CSI sequence -- ESC "[" <params 0x30-0x3F> <intermediates 0x20-0x2F>
    <final 0x40-0x7E> -- is removed WHOLE, because sing-box colours its output even into a
    pipe: `sing-box check` on a config with a missing rule-set emits, measured on 1.13.15
    with stdout=PIPE, b'\\x1b[31mFATAL\\x1b[0m[0000] initialize router: ...'. Dropping the
    ESC byte alone left the residue "[31mFATAL[0m" on the one row this report leans on.
    Only a COMPLETE sequence goes, so no real text can be eaten -- the "[0000]" above is
    logrus' elapsed-time field, not a sequence, and it survives. Other escape forms (OSC,
    charset selection) keep the older ESC-only behaviour: none has been observed from
    these tools and each needs its own terminator grammar. Scanned by hand, not with `re`,
    to keep the fix inside this function; `re` is still not imported by bin/sc.
    """
    text = text.replace("\r", "")
    if "\x1b" not in text:
        return text.rstrip()            # the common path, byte-for-byte as before
    out = []
    i = 0
    n = len(text)
    while True:
        j = text.find("\x1b", i)
        if j < 0:
            out.append(text[i:])
            break
        out.append(text[i:j])
        k = j + 1
        if text[k:k + 1] == "[":
            k += 1
            while k < n and "\x30" <= text[k] <= "\x3f":
                k += 1
            while k < n and "\x20" <= text[k] <= "\x2f":
                k += 1
            if k < n and "\x40" <= text[k] <= "\x7e":
                i = k + 1               # complete CSI: drop it entirely
                continue
        i = j + 1                       # not a complete CSI: drop the ESC byte only
    return "".join(out).rstrip()


def _doctor_run(cmd):
    """(returncode, merged stdout+stderr) of one read-only probe command.

    3.6-safe deliberately: stdout=PIPE + stderr=STDOUT + .decode(), never the 3.7-only
    convenience keywords. Merging stderr keeps a tool's diagnostics inside the report
    instead of leaking around it. OSError (a missing tool) is left to the caller, which is
    how "the tool is not installed" becomes that section's UNKNOWN row, not a traceback.
    """
    r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    return r.returncode, _plain(r.stdout.decode("utf-8", "replace"))


def _first_line(text):
    """First non-blank line of a tool's output, or ""."""
    for line in text.splitlines():
        if line.strip():
            return line
    return ""


def _doctor_binary():
    """S1 — where the sing-box binary is, and what version it reports."""
    path = shutil.which(SB_BIN)
    if not path:
        return [(DOCTOR_PROBLEM, "sing-box binary", t("not found on PATH")),
                (DOCTOR_UNKNOWN, "sing-box version", t("no sing-box binary on PATH"))]
    rows = [(DOCTOR_OK, "sing-box binary", path)]
    try:
        code, out = _doctor_run([SB_BIN, "version"])
    except OSError as e:
        rows.append((DOCTOR_UNKNOWN, "sing-box version",
                     t("cannot determine: {e}", e=_plain(str(e)))))
        return rows
    line = _first_line(out)
    if code != 0 or not line:
        rows.append((DOCTOR_UNKNOWN, "sing-box version",
                     t("the binary produced no version line (exit {code})", code=code)))
    else:
        rows.append((DOCTOR_OK, "sing-box version", line))
    return rows


def _doctor_rulesets():
    """S2 — one row per rule-set: status, size AND age from the SAME single read.

    The head of the owner's failure chain, which is why it prints above the config check.

    The age is rendered by the one age renderer over the one reader's mtime, and the
    staleness verdict is a function of that SAME number — no os.stat, no getmtime, no
    second timestamp source, so the phrase and the verdict can never disagree. A file with
    no complete read has no timestamp, reads as the word form and is never called stale;
    its row is already PROBLEM for its status. Usable-but-stale is PROBLEM and makes the
    summary PROBLEM through the assignment an unusable file already uses, while the
    "{n}/{total} usable" count is unchanged — a stale rule-set IS usable, it is just old.
    """
    states = ruleset_states()
    summary_cls = DOCTOR_OK
    usable = 0
    rows = []
    for _tag, fname, status, _digest, size, mtime, *_rest in states:
        stale = False
        if status == "usable":
            usable += 1
            stale = (mtime is not None
                     and time.time() - mtime >= RULESET_STALE_DAYS * 86400)
        if status == "usable" and not stale:
            cls = DOCTOR_OK
        else:
            cls = DOCTOR_PROBLEM
            summary_cls = DOCTOR_PROBLEM
        reason = _status_text(status)
        age = _age_text(mtime)
        if size is None:
            # No complete read happened, so there is no honest byte count to print.
            value = t("{reason}, size unavailable, {age}", reason=reason, age=age)
        elif stale:
            value = t("{reason}, {size} bytes, {age} — run `sc update-rules` to refresh",
                      reason=reason, size=size, age=age)
        else:
            value = t("{reason}, {size} bytes, {age}", reason=reason, size=size, age=age)
        rows.append((cls, fname, value))
    summary = (summary_cls, "rule-sets",
               t("{n}/{total} usable", n=usable, total=len(states)))
    return [summary] + rows


def _doctor_config():
    """S3 — is there a config, and does the sing-box checker accept it?

    Opens the file only to learn whether it is readable: an EACCES is "cannot read", never
    "absent". A missing binary makes the check UNKNOWN — never "config invalid".

    The drift row is _drift_state()'s three-valued answer rendered and nothing else — no
    second digest is taken here and the judgement is not widened. It is computed FIRST and
    returned on every path, including both early returns, because it sits between the
    "configuration" row and the "sing-box check" row in the causal order: a document the
    user edited is what explains a checker verdict that surprises them. `no record` is
    UNKNOWN, never "drifted" — every host upgrading from a build before the record existed
    has none.
    """
    drift = _drift_state()
    if drift is None:
        drift_row = (DOCTOR_UNKNOWN, "config drift",
                     t("no record of what sc last generated"))
    elif drift:
        drift_row = (DOCTOR_PROBLEM, "config drift",
                     t("changed since sc generated it — keep the change in {override}, "
                       "then run `sc reload`", override=str(OVERRIDE_PATH)))
    else:
        drift_row = (DOCTOR_OK, "config drift", t("matches what sc last generated"))
    try:
        with CFG_PATH.open("rb"):
            pass
    except FileNotFoundError:
        return [(DOCTOR_PROBLEM, "configuration",
                 t("no file at {path}", path=str(CFG_PATH))), drift_row]
    except OSError as e:
        return [(DOCTOR_UNKNOWN, "configuration",
                 t("cannot read {path}: {e}", path=str(CFG_PATH), e=_plain(str(e)))),
                drift_row]
    rows = [(DOCTOR_OK, "configuration", str(CFG_PATH)), drift_row]
    if not shutil.which(SB_BIN):
        rows.append((DOCTOR_UNKNOWN, "sing-box check", t("no sing-box binary on PATH")))
        return rows
    try:
        code, out = _doctor_run([SB_BIN, "check", "-c", str(CFG_PATH)])
    except OSError as e:
        rows.append((DOCTOR_UNKNOWN, "sing-box check",
                     t("cannot determine: {e}", e=_plain(str(e)))))
        return rows
    if code == 0:
        rows.append((DOCTOR_OK, "sing-box check", t("no error reported")))
        return rows
    # The checker's own words, quoted whole and indented: the only rows without a marker,
    # which is exactly what makes them recognisable as quotation.
    lines = [line for line in out.splitlines() if line.strip()]
    if not lines:
        # A checker that fails without saying anything still owes the reader a fact, and
        # its exit code is the only one this path has. Never print a header that promises
        # detail and then nothing — least of all on the broken host doctor exists for.
        rows.append((DOCTOR_PROBLEM, "sing-box check",
                     t("the checker reported an error, no message (exit {code})",
                       code=code)))
        return rows
    rows.append((DOCTOR_PROBLEM, "sing-box check", t("the checker reported an error:")))
    for line in lines[:DOCTOR_MSG_LINES]:
        rows.append((None, None, "    " + line))
    if len(lines) > DOCTOR_MSG_LINES:
        rows.append((None, None, "    " + t("... {n} more line(s) not shown",
                                            n=len(lines) - DOCTOR_MSG_LINES)))
    return rows


def _doctor_ipv6():
    """S4 — this host's effective AAAA decision, and whether config.json carries it.

    ONE row, and exactly ONE ipv6_decision() call per doctor run: the decision's own
    sentence is what the row states, and the same decision is handed to _aaaa_rule() to
    ask the document a membership question. _dns_overlay() is deliberately NOT called from
    anywhere in this block — it would call ipv6_decision() a second time, printing BC-9's
    stderr warning twice and reading the address source twice in one run.

    The row asks "does the document carry the rule this build authors for this decision?",
    which is a membership test and never a second derivation — it re-spells no rule and
    indexes no position. Detection failure (sentence None, already spoken on stderr) is
    UNKNOWN. The document is read exactly once, guarded by (OSError, ValueError) —
    UnicodeDecodeError is a ValueError, not an OSError — and every level below the top is
    guarded by isinstance in stored_delays()' house style, so a `dns` that is a string is
    the honest PROBLEM "the document does not carry it" rather than a TypeError. A document
    that is not a JSON object at all is UNKNOWN: the row above already owns "there is no
    usable document there", and this probe cannot judge what it cannot traverse.
    """
    _setting, suppress, sentence = ipv6_decision()
    if sentence is None:
        return [(DOCTOR_UNKNOWN, "IPv6 (AAAA)",
                 t("cannot determine this host's IPv6 addresses"))]
    try:
        doc = json.loads(CFG_PATH.read_text())
    except (OSError, ValueError) as e:
        return [(DOCTOR_UNKNOWN, "IPv6 (AAAA)",
                 t("cannot read {path}: {e}", path=str(CFG_PATH), e=_plain(str(e))))]
    if not isinstance(doc, dict):
        # No exception was raised, so the cause slot is filled from the existing sentence
        # for exactly this shape. It still goes through _plain(): every {e} in this block
        # does, so no later edit can put foreign text in one that does not.
        return [(DOCTOR_UNKNOWN, "IPv6 (AAAA)",
                 t("cannot read {path}: {e}", path=str(CFG_PATH),
                   e=_plain(t("the top level must be a JSON object"))))]
    dns = doc.get("dns")
    rules = dns.get("rules") if isinstance(dns, dict) else None
    if isinstance(rules, list) and _aaaa_rule(suppress) in rules:
        return [(DOCTOR_OK, "IPv6 (AAAA)",
                 t("{decision}; config.json carries this decision", decision=sentence))]
    return [(DOCTOR_PROBLEM, "IPv6 (AAAA)",
             t("{decision}; config.json does not carry this decision — run `sc reload` "
               "to regenerate it", decision=sentence))]


def _doctor_service():
    """S5 — running now, and registered to start at boot: two separate facts.

    The init-system check runs FIRST, so is_running()'s hard False on a host with neither
    systemd nor OpenRC is never rendered as "not running".

    Both facts are read from the init system rather than from settings["default_tun"]:
    that key records what `sc on/off` was last told to do, while the init system is the
    authority on what will actually happen at boot. A disagreement between them is itself
    a defect worth seeing, and only the authority can show it.
    """
    if not SYSTEMD and not OPENRC:
        cause = t("no init system detected (neither systemd nor OpenRC)")
        return [(DOCTOR_UNKNOWN, "service", cause),
                (DOCTOR_UNKNOWN, "boot autostart", cause)]
    init = "systemd" if SYSTEMD else "OpenRC"
    running = is_running()
    rows = [(DOCTOR_OK if running else DOCTOR_PROBLEM, "service",
             t("running (via {init})", init=init) if running
             else t("not running (via {init})", init=init))]
    try:
        if SYSTEMD:
            code, out = _doctor_run(["systemctl", "is-enabled", SERVICE])
            state = _first_line(out)
            enabled = (code == 0 and state == "enabled")
        else:
            _code, out = _doctor_run(["rc-update", "show", "default"])
            enabled = any(SERVICE in line.split() for line in out.splitlines())
            state = t("not in the default runlevel")
    except OSError as e:
        rows.append((DOCTOR_UNKNOWN, "boot autostart",
                     t("cannot determine: {e}", e=_plain(str(e)))))
        return rows
    if enabled:
        rows.append((DOCTOR_OK, "boot autostart", t("enabled")))
    else:
        rows.append((DOCTOR_PROBLEM, "boot autostart",
                     t("not enabled ({state})", state=_plain(state))))
    return rows


def _doctor_tun():
    """S6 — does this project's TUN device exist, and what addresses does it carry?

    `ip`'s operstate is deliberately not printed: for a TUN device it reads literally
    UNKNOWN and would collide with the outcome-class vocabulary.
    """
    try:
        code, out = _doctor_run(["ip", "-br", "addr", "show", TUN_IFACE])
    except OSError as e:
        return [(DOCTOR_UNKNOWN, "TUN interface",
                 t("cannot query: {e}", e=_plain(str(e))))]
    fields = []
    for line in out.splitlines():
        parts = line.split()
        if parts and parts[0].split("@")[0] == TUN_IFACE:
            fields = parts
            break
    if code != 0 or not fields:
        return [(DOCTOR_PROBLEM, "TUN interface",
                 t("{iface} does not exist", iface=TUN_IFACE))]
    addrs = fields[2:]      # name, operstate, then every address
    return [(DOCTOR_OK, "TUN interface", TUN_IFACE),
            (DOCTOR_OK if addrs else DOCTOR_PROBLEM, "TUN addresses",
             ", ".join(addrs) if addrs else t("(none)"))]


def _doctor_clash():
    """S7 — the persisted Clash API port, whether it answers, how many nodes carry a
    stored delay, and one measured name lookup through the running install.

    The port comes from settings only. doctor never probes for a free port (that would
    report "unreachable" as a tautology) and never reads the module-level CLASH_PORT,
    which a doctor run deliberately leaves unresolved.

    The last two rows live HERE, not in sections of their own, because both depend on the
    fact this section already holds — did the API answer? — and asking again would be a
    second request and a second opinion. Both are computed ONLY on the branch where
    /configs answered: with no port recorded, or with nothing answering, they are UNKNOWN
    and NO request and no lookup is issued at all. Neither adds a try/except around
    clash_api(): it is total, and a second envelope is the defect, not the fix.

    Nothing here claims a fresh measurement of a node: the Clash API serves a url-test
    HISTORY. The DNS row's milliseconds ARE measured, around the one call — and no row
    states a timeout value or a wall-clock bound, because urlopen(timeout=N) bounds each
    socket operation and not the call.
    """
    port = _saved_clash_port()
    if port is None:
        pending = t("not probed — no port recorded")
        return [(DOCTOR_UNKNOWN, "Clash API", t("no port recorded in settings.json")),
                (DOCTOR_UNKNOWN, "Clash API responding", pending),
                (DOCTOR_UNKNOWN, "node delays", pending),
                (DOCTOR_UNKNOWN, "DNS lookup", pending)]
    addr = "127.0.0.1:%d" % port
    rows = [(DOCTOR_OK, "Clash API", addr)]
    answer = clash_api("GET", "/configs", port=port)
    # `is None`: an empty body legitimately answers with {}, which is falsy.
    if answer is None:
        # States what was observed and nothing about why: a refusal, a reset, a bad status
        # and a slow peer all arrive here identically, and the row above names the port.
        pending = t("not probed — the Clash API did not answer")
        return rows + [(DOCTOR_PROBLEM, "Clash API responding",
                        t("no usable answer from {addr}", addr=addr)),
                       (DOCTOR_UNKNOWN, "node delays", pending),
                       (DOCTOR_UNKNOWN, "DNS lookup", pending)]
    rows.append((DOCTOR_OK, "Clash API responding", t("yes")))
    try:
        nodes = load_nodes()["nodes"]
        total = len(nodes)
        tags = set(node["tag"] for node in nodes)
    except (OSError, ValueError, TypeError, KeyError) as e:
        # Absent, unreadable, not UTF-8, not JSON, or JSON of the wrong shape — one
        # UNKNOWN row naming the file, never a traceback and never a fabricated count.
        rows.append((DOCTOR_UNKNOWN, "node delays",
                     t("cannot read {path}: {e}", path=str(NODES_PATH), e=_plain(str(e)))))
    else:
        if not total:
            rows.append((DOCTOR_OK, "node delays", t("no nodes configured")))
        else:
            delays, current = stored_delays(port=port)
            n = len(tags & set(delays))
            if n:
                rows.append((DOCTOR_OK, "node delays",
                             t("{n}/{total} nodes carry a stored delay (history, not a "
                               "fresh measurement); auto-select is on {current}",
                               n=n, total=total,
                               current=_plain(current or t("(none)")))))
            else:
                rows.append((DOCTOR_PROBLEM, "node delays",
                             t("0/{total} nodes carry a stored delay — either no probe "
                               "has completed yet or every node is failing; see `sc ls`",
                               total=total)))
    # One lookup, of the SAME name the egress row resolves, asked of the running install's
    # own DNS router rather than of this host's resolver: on a machine whose TUN device is
    # down a host-side lookup would silently measure the wrong thing. Read-only GET.
    started = time.monotonic()
    lookup = clash_api("GET", "/dns/query?name=" + EGRESS_HOST + "&type=A", port=port)
    ms = int((time.monotonic() - started) * 1000)
    if lookup is None:
        rows.append((DOCTOR_PROBLEM, "DNS lookup",
                     t("no answer for {name} after {ms} ms — try another node with "
                       "`sc use <n>`", name=EGRESS_HOST, ms=ms)))
    elif isinstance(lookup.get("Answer"), list) and lookup["Answer"]:
        rows.append((DOCTOR_OK, "DNS lookup",
                     t("{name} resolved in {ms} ms, through the running sing-box",
                       name=EGRESS_HOST, ms=ms)))
    else:
        rows.append((DOCTOR_PROBLEM, "DNS lookup",
                     t("{name} returned no records after {ms} ms — try another node with "
                       "`sc use <n>`", name=EGRESS_HOST, ms=ms)))
    return rows


def _doctor_egress():
    """S8 — the observed public egress address.

    Unconditional, unlike `sc status`: "the service is down and my egress IP is my ISP
    address" is a confirmation, not noise. Makes no claim about whether it is proxied.
    """
    try:
        return [(DOCTOR_OK, "egress IP", _plain(_egress_ip()))]
    except Exception as e:
        return [(DOCTOR_PROBLEM, "egress IP", t("(error: {e})", e=_plain(str(e))))]


def _doctor_permissions():
    """S9 — does anything in the configuration directory grant access to group or other?

    LAST, because a wrong mode explains no other row on the screen; the ordering rule puts
    a row above another only when its failure would explain it.

    Two predicates, both this project's own. A regular file is offending when
    `mode & 0o077` — T-13's own test, the one the installer's sweep uses — and the
    directory is offending only when `mode & 0o022`, i.e. group- or other-WRITABLE: that
    is the rename-between-fchmod-and-replace window, whereas the world-readable traversable
    mode every host has would fire on 100% of installs and teach people to ignore the row.
    settings.json is the one exclusion (it carries no credential), and there is no filename
    pattern anywhere — which is exactly how a hand-made `config.json.bak-<date>` at 0644,
    invisible to any enumerated sweep, is caught.

    REPORTS ONLY. It never chmods, never creates the directory, never follows a symlink
    (lstat, so a planted link's target mode can never be printed as the link's) and never
    descends into a sub-directory. It reads modes, never one byte of any file's CONTENT.
    """
    try:
        dir_mode = CFG_DIR.stat().st_mode
    except FileNotFoundError:
        return [(DOCTOR_UNKNOWN, "file permissions",
                 t("no directory at {path}", path=str(CFG_DIR)))]
    except OSError as e:
        return [(DOCTOR_UNKNOWN, "file permissions",
                 t("cannot read {path}: {e}", path=str(CFG_DIR), e=_plain(str(e))))]
    details = []
    wide = 0
    links = 0
    if dir_mode & 0o022:
        wide += 1
        details.append(t("{path} is mode {mode} — run: {cmd}", path=_plain(str(CFG_DIR)),
                         mode="%03o" % (dir_mode & 0o777),
                         cmd="chmod go-w " + _plain(str(CFG_DIR))))
    try:
        entries = sorted(CFG_DIR.iterdir())
    except OSError as e:
        return [(DOCTOR_UNKNOWN, "file permissions",
                 t("cannot read {path}: {e}", path=str(CFG_DIR), e=_plain(str(e))))]
    for entry in entries:
        try:
            mode = entry.lstat().st_mode
        except OSError:
            # The entry went away between the listing and the read — a _write_private()
            # temporary being renamed onto its target is exactly that, and doctor may not
            # lock, retry or block. Skipping the vanished path costs one finding a re-run
            # would make anyway, where degrading the section would cost every other path.
            continue
        if stat.S_ISLNK(mode):
            links += 1
            details.append(t("{path} is a symbolic link; sc never creates one here — "
                             "check it with: ls -l {path}", path=_plain(str(entry))))
        elif stat.S_ISREG(mode) and entry.name != "settings.json" and mode & 0o077:
            wide += 1
            details.append(t("{path} is mode {mode} — run: {cmd}", path=_plain(str(entry)),
                             mode="%03o" % (mode & 0o777),
                             cmd="chmod %03o %s" % (CRED_MODE, _plain(str(entry)))))
    if wide:
        # A wide mode outranks an unjudgeable link: one of them is actionable now.
        rows = [(DOCTOR_PROBLEM, "file permissions",
                 t("{n} path(s) grant access to group or other — run the command shown "
                   "for each", n=wide))]
    elif links:
        rows = [(DOCTOR_UNKNOWN, "file permissions",
                 t("{n} path(s) could not be judged — see below", n=links))]
    else:
        # Exactly one row on a clean host, naming no path: the report may not grow with
        # the directory's contents when there is nothing to act on. It says CREDENTIAL
        # file, not file: settings.json is excluded above whatever its mode, and
        # save_settings() writes it 0644, so the wider sentence would be false on a
        # default install — the promise stays exactly as wide as the check.
        return [(DOCTOR_OK, "file permissions",
                 t("no credential file grants access to group or other, and the "
                   "directory is not group- or other-writable"))]
    for line in details[:DOCTOR_MSG_LINES]:
        rows.append((None, None, "    " + line))
    if len(details) > DOCTOR_MSG_LINES:
        rows.append((None, None, "    " + t("... {n} more line(s) not shown",
                                            n=len(details) - DOCTOR_MSG_LINES)))
    return rows


# THE print order, and the only place it is decided: reading this tuple top to bottom is
# the review of the causal ordering. No probe prints another section's rows.
DOCTOR_SECTIONS = (
    ("sing-box binary", _doctor_binary),
    ("rule-sets", _doctor_rulesets),
    ("configuration", _doctor_config),
    ("IPv6 (AAAA)", _doctor_ipv6),
    ("service", _doctor_service),
    ("TUN interface", _doctor_tun),
    ("Clash API", _doctor_clash),
    ("egress IP", _doctor_egress),
    ("file permissions", _doctor_permissions),
)


def _doctor_print(cls, label, value):
    """One report row, flushed. `cls is None` prints a verbatim quoted line.

    The row shape — "[<class>] <label>: <value>" with the brackets and the ": " outside
    t() — is pinned here: it is what makes every row greppable and quotable on its own.
    No padding is computed anywhere, so zh's double-width text cannot misalign anything.
    """
    if cls is None:
        print(value, flush=True)
    else:
        print("[" + t(DOCTOR_MARK[cls]) + "] " + t(label) + ": " + value, flush=True)


def cmd_doctor(args):
    """The driver: per-section isolation, streaming, and the exit status."""
    worst = DOCTOR_OK
    for label_key, probe in DOCTOR_SECTIONS:
        try:
            rows = probe()
        except Exception as e:
            # `Exception`, never BaseException and never a bare except: KeyboardInterrupt
            # must still interrupt the 8 s egress wait. One failing probe costs its own
            # section's facts and nothing else — every label is still printed.
            rows = [(DOCTOR_UNKNOWN, None,
                     t("this check could not run: {e}", e=_plain(str(e))))]
        for cls, label, value in rows:
            # Flushed per row: without it the whole report would sit in the block buffer
            # when stdout is a pipe, which is precisely the bug-report case.
            _doctor_print(cls, label_key if label is None else label, value)
            if cls is not None:
                worst = max(worst, cls)
    sys.exit(DOCTOR_EXIT[worst])


# ============ config ============
# `sc config` prints the document at CFG_PATH with every node credential replaced by the
# mask. It writes nothing, opens no socket, starts no subprocess, and forms no opinion about
# whether the document is valid — `sc doctor` owns that verdict and stays its only home.
#
# Redaction is UNCONDITIONAL and has no opt-out. install.sh grants the install user
# NOPASSWD on /usr/local/bin/sc, so an unredacted rendering — flag, setting or environment
# variable — would turn a password-gated read of a 0600 credential document into a
# password-free one for any process running as that user. The unredacted document stays
# reachable exactly one way: reading the file as root.

MASK = "******"
# Six U+002A, and deliberately fewer than eight: verify_all A.1 flags a credential-looking
# key followed by a quoted literal of 8 or more characters, and this literal is written next
# to such key names by construction. Never translated (it lives inside a JSON document, not
# in UI text), identical for every masked value, and carrying nothing derived from the value
# it replaced — no length, no prefix, no digest.

# THE visible key set: the only key names whose values render verbatim inside `outbounds`.
# Derived, not curated — every key name sc emits inside an outbound, minus uuid / password /
# public_key / short_id, plus `detour`, sing-box's outbound-chaining key, which sc itself
# never emits (an override-supplied chain should still read as a chain).
# ANY later change that emits a new key inside an outbound — a new share-link parser, a new
# overlay — must add that key's non-credential names HERE in the same change. The failure
# direction of forgetting is a masked field, never a leaked one.
VISIBLE_IN_OUTBOUND = frozenset((
    "type", "tag", "server", "server_port", "detour",
    "outbounds", "default", "url", "interval", "tolerance", "idle_timeout",
    "interrupt_exist_connections",
    "method", "security", "alter_id", "flow", "packet_encoding",
    "congestion_control", "udp_relay_mode",
    "transport", "tls", "obfs", "enabled", "server_name", "alpn", "insecure",
    "utls", "fingerprint", "reality", "path", "host", "headers", "Host",
    "service_name",
))

# Masked at EVERY depth of the whole document, `outbounds` included, and tested BEFORE the
# region rule, so sitting inside a visible container can never expose one. A floor, not the
# guarantee: a value the user places outside `outbounds` under a name that is not here is
# printed verbatim — the limit both READMEs state.
SECRET_KEYS = frozenset((
    "password", "uuid", "secret", "token", "private_key", "pre_shared_key",
))


def _redact(value, strict):
    """`value` with every credential replaced by MASK. Pure: no I/O, no mutation, total.

    Two rules in one walk. SECRET_KEYS is tested first and applies everywhere, so a
    name-based credential is masked wherever it sits. `strict` is the region rule: it turns
    true on descent into any key named `outbounds` and never turns back, so inside that
    array a key outside the visible key set has its WHOLE value masked at every depth —
    which is what makes an override-supplied protocol, or a field a future sing-box version
    adds, fail CLOSED instead of printing.

    The KEY is never replaced, only its value, whatever that value's JSON type — so which
    fields exist stays observable, and a credential that is a number is masked rather than
    preserved. Anything that is neither list nor dict is returned unchanged.
    """
    if isinstance(value, list):
        return [_redact(v, strict) for v in value]
    if not isinstance(value, dict):
        return value
    out = {}
    for k, v in value.items():
        if k in SECRET_KEYS:
            out[k] = MASK
        elif strict and k not in VISIBLE_IN_OUTBOUND:
            out[k] = MASK
        else:
            out[k] = _redact(v, strict or k == "outbounds")
    return out


def cmd_config(args):
    """Print config.json with node credentials masked: document on stdout, notes on stderr.

    The split is the point: `sc config > file` yields a JSON document a parser accepts, and
    `sc config | <filter>` works, while everything sc says about the document stays visible
    when the command is not redirected.

    Writes no file and touches no service, socket or subprocess — main() keeps this command
    off _init_files() / _resolve_clash_port(), the two writers on the shared start-up path.
    Exactly ONE write reaches stdout and its argument always goes through _redact(), so
    there is no branch through which an unmasked value can be printed.
    """
    try:
        raw = CFG_PATH.read_text()
    except FileNotFoundError:
        sys.exit(_plain(t("no file at {path}", path=str(CFG_PATH))))
    except (OSError, ValueError) as e:
        # ValueError is not redundant: a document that is not valid UTF-8 raises
        # UnicodeDecodeError, which is a ValueError and NOT an OSError, so the habitual
        # `except OSError` would let it through as a traceback.
        sys.exit(_plain(t("cannot read {path}: {e}",
                          path=str(CFG_PATH), e=_plain(str(e)))))
    try:
        doc = json.loads(raw)
    except ValueError as e:
        # The raw text is deliberately NOT printed: content that cannot be parsed cannot be
        # masked, and printing it would hand over the credentials whole.
        sys.exit(_plain(t("Cannot use {path}: {problem}", path=CFG_PATH,
                          problem=t("not valid JSON ({err})", err=str(e)))))
    if not isinstance(doc, dict):
        sys.exit(_plain(t("Cannot use {path}: {problem}", path=CFG_PATH,
                          problem=t("the top level must be a JSON object"))))
    sys.stderr.write(t("Showing the configuration on disk: {path}",
                       path=str(CFG_PATH)) + "\n")
    sys.stderr.write(t("Node credentials are masked; a masked value shows as {mask}.",
                       mask=MASK) + "\n")
    drifted = _drift_state()
    if drifted is True:
        sys.stderr.write(t("This has drifted from what sc last generated.") + "\n")
    elif drifted is False:
        sys.stderr.write(t("This is what sc last generated.") + "\n")
    # Flushed at the stream boundary, BEFORE the first stdout byte: on this project's
    # Python 3.6 floor a redirected sys.stderr is block-buffered (it became unconditionally
    # line-buffered only in 3.9), so `sc config > f 2>&1` would otherwise interleave by
    # buffer-drain order rather than by write order.
    sys.stderr.flush()
    try:
        sys.stdout.write(json.dumps(_redact(doc, False),
                                    indent=2, ensure_ascii=False) + "\n")
        sys.stdout.flush()
    except BrokenPipeError:
        # `sc config | head -5`. stderr is already flushed above, this process holds no
        # other buffered stream and registers no atexit handler, so os._exit(1) discards
        # exactly the stdout bytes whose reader is gone — and, unlike sys.exit(1), it skips
        # the interpreter's shutdown flush, which is what would otherwise print
        # "Exception ignored in: <_io.TextIOWrapper ...>" after the last line.
        os._exit(1)


def cmd_mode(args):
    mode = args.mode.lower()
    if mode not in ("rule", "global", "direct"):
        sys.exit(t("Error: mode must be one of rule / global / direct"))
    settings = load_settings()
    settings["mode"] = mode
    save_settings(settings)
    if is_running():
        clash_api("PATCH", "/configs", {"mode": mode})
    print(t("Route mode → {mode}", mode=mode))


def cmd_ipv6(args):
    """`sc ipv6 on|off|auto|show` — the one surface of the effective IPv6 decision.

    Everything printed comes from ipv6_decision(), including the before/after comparison,
    so this command cannot form a second opinion about what the document will do.

    A set that leaves the effective decision unchanged touches nothing: `auto` on a host
    that was already deciding `auto`, or `on` on a host with a global IPv6 address, would
    otherwise drop every live connection to rewrite the same bytes. The setting is still
    persisted in that case, which is what makes `sc ipv6 auto` repair a hand-edited
    unrecognised value.

    NOTE ON SCOPE: "show writes nothing" is a property of THIS function. main()'s start-up
    path (_init_files() + _resolve_clash_port()) runs for `sc ipv6` exactly as for every
    other non-doctor command and can create /etc/sing-box and persist a port on a fresh
    host. `doctor` stays the one positively named read-only command.
    """
    val = args.value.lower()
    if val not in ("on", "off", "auto", "show"):
        sys.exit(t("Error: argument must be one of on / off / auto / show"))
    if val == "show":
        setting, _suppress, sentence = ipv6_decision()
        print(t("IPv6 name resolution → {val}", val=setting))
        if sentence is not None:
            print(sentence)
        return
    before = ipv6_decision()[1]
    settings = load_settings()
    settings["ipv6"] = val
    save_settings(settings)
    setting, after, sentence = ipv6_decision()
    print(t("IPv6 name resolution → {val}", val=setting))
    if sentence is not None:
        print(sentence)
    if after == before:
        print(t("Nothing changed — the sing-box service was not touched"))
        return
    if not reload_or_restart():
        sys.exit(t("Reload failed"))
    print(t("Configuration regenerated; sing-box restarted"))


def _telemetry_meaning(setting):
    """THE mapping from the effective setting to the already-translated sentence saying what
    it means for a listed name. Both forms of cmd_telemetry() print it, so spelling the
    conditional at each of the two sites would be two definitions of one judgment; it takes
    the setting as an argument rather than reading it, so it adds no second reader either.
    """
    if setting == "block":
        return t("Listed names are answered \"no such domain\" locally; nothing is asked "
                 "upstream")
    return t("Listed names resolve normally")


def cmd_telemetry(args):
    """`sc telemetry block|allow|show` — the one surface of the telemetry reject list.

    The setting and its meaning both come from _telemetry_setting(), including the
    before/after comparison, so this command cannot form a second opinion about what the
    document will do. The list printed by `show` is TELEMETRY_NAMES itself, so it cannot
    drift from the emitted rule either.

    A set that leaves the EFFECTIVE setting unchanged touches nothing — it would otherwise
    drop every live connection to rewrite the same bytes. The setting is still persisted in
    that case, which is what makes `sc telemetry block` repair a hand-edited unrecognised
    value: the file changes, the effective setting does not, and nothing service-affecting
    happens. The no-op line names `sc reload` because the one state where "nothing changed"
    misleads is a config generated before this setting existed.

    Each line of the list is the bare name: a name is language-neutral, so there is nothing
    in it to translate, and a per-name description would either ship untranslated English
    mid-list or blow the string budget. The per-name justification lives beside
    TELEMETRY_NAMES and in both READMEs.

    NOTE ON SCOPE: "show writes nothing" is a property of THIS function. main()'s start-up
    path (_init_files() + _resolve_clash_port()) runs for `sc telemetry` exactly as for every
    other non-doctor command and can create /etc/sing-box and persist a port on a fresh host.
    `doctor` stays the one positively named read-only command.
    """
    val = args.value.lower()
    if val not in ("block", "allow", "show"):
        sys.exit(t("Error: argument must be one of block / allow / show"))
    if val == "show":
        setting = _telemetry_setting()
        print(t("Telemetry name rejection → {val}", val=setting))
        print(_telemetry_meaning(setting))
        for name in TELEMETRY_NAMES:
            print(name)
        return
    before = _telemetry_setting()
    settings = load_settings()
    settings["telemetry"] = val
    save_settings(settings)
    setting = _telemetry_setting()
    print(t("Telemetry name rejection → {val}", val=setting))
    print(_telemetry_meaning(setting))
    if setting == before:
        print(t("Nothing changed — the sing-box service was not touched; run `sc reload` "
                "to apply this setting to a configuration generated before it"))
        return
    if not reload_or_restart():
        sys.exit(t("Reload failed"))
    print(t("Configuration regenerated; sing-box restarted"))


def cmd_default_tun(args):
    val = args.value.lower()
    if val not in ("on", "off"):
        sys.exit(t("Error: argument must be on or off"))
    if val == "on":
        if SYSTEMD:
            subprocess.run(["systemctl", "enable", SERVICE], check=False)
        elif OPENRC:
            subprocess.run(["rc-update", "add", SERVICE, "default"], check=False)
    else:
        if SYSTEMD:
            subprocess.run(["systemctl", "disable", SERVICE], check=False)
        elif OPENRC:
            subprocess.run(["rc-update", "del", SERVICE, "default"], check=False)
    settings = load_settings()
    settings["default_tun"] = (val == "on")
    save_settings(settings)
    print(t("Boot autostart → {val}", val=val))


def cmd_sysproxy(args):
    val = args.value.lower()
    if val not in ("on", "off"):
        sys.exit(t("Error: argument must be on or off"))
    user = os.environ.get("SUDO_USER") or os.environ.get("USER")
    if not user:
        sys.exit(t("Error: cannot determine target user"))
    if val == "on":
        cmds = [
            ["gsettings", "set", "org.gnome.system.proxy", "mode", "manual"],
            ["gsettings", "set", "org.gnome.system.proxy.http", "host", "127.0.0.1"],
            ["gsettings", "set", "org.gnome.system.proxy.http", "port", "7890"],
            ["gsettings", "set", "org.gnome.system.proxy.https", "host", "127.0.0.1"],
            ["gsettings", "set", "org.gnome.system.proxy.https", "port", "7890"],
            ["gsettings", "set", "org.gnome.system.proxy.socks", "host", "127.0.0.1"],
            ["gsettings", "set", "org.gnome.system.proxy.socks", "port", "7890"],
        ]
    else:
        cmds = [["gsettings", "set", "org.gnome.system.proxy", "mode", "none"]]
    for c in cmds:
        subprocess.run(["sudo", "-u", user] + c, check=False)
    print(t("GNOME system proxy → {val}", val=val))


def cmd_update_rules(args):
    RULES_DIR.mkdir(parents=True, exist_ok=True)
    bases = _ruleset_bases(getattr(args, "mirror", None))
    tty = sys.stdout.isatty()
    before = ruleset_states()
    dead = set()        # a base that failed once is not retried in this run: with four
    failed = []         # bases the whole run still pays at most four timeouts, as today
    for fname, relpath in RULESET_FILES:
        target = RULES_DIR / fname
        tmp = _temp_path(fname)
        prefix = f"  ↓ {fname} ... "
        print(prefix, end="", flush=True)
        _clear_stale_temps(fname)
        # Two lists, deliberately: `causes` names EVERY base in list order (dead-skips
        # included) and feeds the total-failure line; `tried` names only the bases really
        # contacted and rejected for THIS file and is appended to the success line, so a
        # broken mirror stays visible when a later one works. Excluding dead-skips from
        # `tried` keeps one real cause per base per run and leaves the happy path (base 1
        # answers ⇒ `tried` empty ⇒ note empty) byte-identical.
        causes = []
        tried = []
        for base in bases:
            if base in dead:
                causes.append(base + " -> "
                              + t("skipped (this source already failed in this run)"))
                continue
            url = base.rstrip("/") + "/" + relpath
            try:
                got = _fetch_to_temp(url, tmp, prefix, tty)
                tmp.replace(target)     # atomic, and only after validation passed
                note = (t("; fell back after: {causes}", causes="; ".join(tried))
                        if tried else "")
                # ONE print, ONE completion line, no \r on the non-TTY path.
                print(t("OK ({size} bytes)", size=got) + note)
                break
            except Exception as e:
                dead.add(base)
                entry = base + " -> " + str(e)
                causes.append(entry)
                tried.append(entry)
                try:
                    tmp.unlink()        # never leave debris; the real path is untouched
                except OSError:
                    pass
        else:
            # Every base exhausted. The cause names each one, on stdout, one line.
            failed.append(fname)
            print(t("failed: {e}", e="; ".join(causes)))

    after = ruleset_states()
    gained = sorted(usable_tags(_status_view(after)) - usable_tags(_status_view(before)))
    changed = changed_usable_tags(before, after)    # gained is a subset of changed
    regen_ok = True     # hoisted: `ok` below is the run's ONE success record
    restarted = None    # tri-state: None = not attempted, True/False = what it returned
    # THE apply decision — one per run, for the whole run. `changed` is empty unless some
    # rule-set's installed BYTES really differ from what was on disk before the downloads,
    # so a run that re-fetched four byte-identical files touches nothing at all.
    # No config yet (fresh install) ⇒ do nothing: the installer generates the first one.
    if changed and CFG_PATH.exists():
        if gained:
            # Recovery: regenerate (never patch) so the restored rule-sets are actually
            # used. Runs before the non-zero exit, so a partial recovery still repairs the
            # config, and a failed check still blocks the restart below.
            regen_ok = generate_config()
            if regen_ok:    # never claim a regeneration that did not happen
                print(t("Rule-sets restored: {names} — config regenerated",
                        names=", ".join(gained)))
        if regen_ok and is_running():
            print("\n" + t("→ Restarting sing-box ..."))
            # The restart is conditional on changed_usable_tags(); an unconditional restart
            # here is the T-10 defect — it dropped every live connection (a remote admin's
            # own SSH included) on every weekly timer run, for four unchanged files.
            restarted = restart_service()
    # THE determination: one expression, read by both the outcome sentence and the exit.
    ok = not failed and regen_ok and restarted is not False
    # Exactly one truthful run-level outcome, always, before the exit: a run that ends
    # non-zero must still state what it did to the service.
    if not changed:
        print(t("No rule-set changed — the sing-box service was not touched"))
    elif restarted:
        print(t("Rule-sets updated: {names} — sing-box restarted to load them",
                names=", ".join(changed)))
    elif restarted is False:
        print(t("Rule-sets updated: {names} — the sing-box service could not be restarted",
                names=", ".join(changed)))
    else:
        print(t("Rule-sets updated: {names} — the sing-box service was not touched",
                names=", ".join(changed)))
    if failed:
        sys.stdout.flush()      # sys.exit(<str>) flushed first; install.sh merges the streams
        sys.stderr.write("\n" + t("{n} ruleset(s) failed to update", n=len(failed)) + "\n")
    if not ok:
        sys.exit(1)     # the ONE exit site: same record the outcome line was drawn from
    print(t("Done"))

def cmd_update_interval(args):
    val = args.value.strip()

    if SYSTEMD:
        if val == "show":
            subprocess.run(
                ["systemctl", "list-timers", "--all",
                 "sing-box-rules-update.timer", "--no-pager"],
                check=False,
            )
            return

        presets = {"hourly": "hourly", "daily": "daily",
                   "weekly": "weekly", "monthly": "monthly"}
        if val.lower() in presets:
            on_calendar = presets[val.lower()]
        elif val.startswith("OnCalendar="):
            on_calendar = val[len("OnCalendar="):]
        else:
            on_calendar = val

        override_dir = Path("/etc/systemd/system/sing-box-rules-update.timer.d")
        override_dir.mkdir(parents=True, exist_ok=True)
        (override_dir / "override.conf").write_text(
            f"[Timer]\nOnCalendar=\nOnCalendar={on_calendar}\n"
        )

        subprocess.run(["systemctl", "daemon-reload"], check=False)
        r = subprocess.run(
            ["systemctl", "restart", "sing-box-rules-update.timer"],
            capture_output=True, text=True,
        )
        if r.returncode != 0:
            sys.exit(t("Error: applying timer failed: {err}", err=r.stderr.strip()))

        settings = load_settings()
        settings["update_interval"] = val
        save_settings(settings)

        print(t("Ruleset auto-update cadence → {val} (OnCalendar={oc})", val=val, oc=on_calendar))
        print("\n" + t("=== Next run ==="))
        subprocess.run(
            ["systemctl", "list-timers", "sing-box-rules-update.timer", "--no-pager"],
            check=False,
        )

    elif OPENRC:
        if val == "show":
            active = None
            for period, d in PERIODIC_DIRS.items():
                if (d / PERIODIC_SCRIPT).exists():
                    active = period
                    break
            if active:
                print(t("Ruleset auto-update: {period} (via /etc/periodic/{period}/)",
                        period=active))
            else:
                print(t("No automatic ruleset update configured. Run `sc update-interval daily|weekly|monthly` to set up."))
            return

        if val.lower() not in PERIODIC_DIRS:
            sys.exit(t("OpenRC only supports daily / weekly / monthly intervals. Use systemd for custom OnCalendar expressions."))

        # Remove from all period dirs first, then write to the chosen one
        for d in PERIODIC_DIRS.values():
            script = d / PERIODIC_SCRIPT
            if script.exists():
                script.unlink()
        target_dir = PERIODIC_DIRS[val.lower()]
        target_dir.mkdir(parents=True, exist_ok=True)
        script = target_dir / PERIODIC_SCRIPT
        script.write_text("#!/bin/sh\n/usr/local/bin/sc update-rules\n")
        script.chmod(0o755)

        settings = load_settings()
        settings["update_interval"] = val
        save_settings(settings)

        print(t("Ruleset auto-update cadence → {val} (OnCalendar={oc})", val=val, oc=val))
        print(t("Ruleset auto-update: {period} (via /etc/periodic/{period}/)", period=val.lower()))


def cmd_log(args):
    if SYSTEMD:
        if args.follow:
            subprocess.run(["journalctl", "-u", SERVICE, "-f"])
        else:
            subprocess.run(["journalctl", "-u", SERVICE, "-n", "100", "--no-pager"])
    else:
        # OpenRC: sing-box writes to /var/log/sing-box/ via supervise-daemon
        log_candidates = [
            Path("/var/log/sing-box/error.log"),
            Path("/var/log/sing-box/access.log"),
        ]
        log = next((p for p in log_candidates if p.exists()), log_candidates[0])
        if args.follow:
            subprocess.run(["tail", "-f", str(log)], check=False)
        else:
            subprocess.run(["tail", "-n", "100", str(log)], check=False)


def cmd_reload(args):
    if reload_or_restart():
        print(t("Reloaded"))
    else:
        sys.exit(t("Reload failed"))


def cmd_lang(args):
    val = args.value.lower()
    if val not in ("en", "zh"):
        sys.exit(t("Error: language must be 'en' or 'zh'"))
    settings = load_settings()
    settings["lang"] = val
    save_settings(settings)
    global LANG
    LANG = val
    print(t("Language → {val}", val=val))


def cmd_uninstall(args):
    script = LIB_DIR / "uninstall.sh"
    if script.exists():
        os.execvp("bash", ["bash", str(script)])
    sys.exit(t(
        "Uninstall script not found: {script}\n"
        "Use the one-line command to uninstall:\n"
        "  sudo bash -c \"$(curl -fsSL https://raw.githubusercontent.com/Alan-IFT/singbox-cli/main/uninstall.sh)\"",
        script=script,
    ))


HELP_EN = """sc — sing-box CLI manager

USAGE
  sc <command> [args]

COMMANDS
  ls                          List all nodes (● = currently active)
  now                         Show the currently active node
  use <name|index|auto>       Switch active node (instant via Clash API, no restart)
                                auto = the auto-select group: sing-box probes every node
                                       and moves traffic to the fastest that answers
  add <share-link>            Add a node from a share link
                              Supports vless / vmess / trojan / ss / hysteria2 / tuic
  rm <name|index>             Remove a node
  on                          Start sing-box and enable on boot
  off                         Stop sing-box and disable on boot
  status                      Show service status, TUN interface, rule-set status + age,
                              active node, egress IP
  doctor                      Diagnose the install: seven read-only checks, causal order
                                changes nothing — no config, no download, no restart
                                exit 0 = every section OK
                                exit 1 = at least one PROBLEM
                                exit 2 = no PROBLEM, but at least one UNKNOWN
  config                      Print /etc/sing-box/config.json with node credentials masked
                                reads only — writes no file, touches no service
                                a masked value shows as ****** (the key stays visible)
                                the document goes to stdout, these notes to stderr
  mode <rule|global|direct>   Switch route mode (live)
                                rule   = rule-based routing (default)
                                global = everything via proxy
                                direct = everything direct
  ipv6 <on|off|auto|show>     Whether AAAA (IPv6) queries are resolved or answered empty
                                auto = answer empty unless this host has a global IPv6
                                       address (the default; on / off decide it by hand)
                                show = print the setting and the decision it produces
  telemetry <block|allow|show>  Answer a fixed list of telemetry names "no such domain"
                                block = reject them locally, asking no resolver (default)
                                show  = print the setting and every name on the list
  default-tun <on|off>        Toggle boot autostart of sing-box independently
  sysproxy <on|off>           Toggle GNOME system proxy (HTTP/SOCKS 7890; usually unneeded with TUN)
  update-rules [--mirror URL] Update .srs rulesets now (several mirrors are tried in
                              order and every download is validated before install)
                                --mirror URL  use this base URL instead of the built-in
                                              mirror list; repeatable, and one value may
                                              hold several whitespace-separated URLs
                                env SB_RULES_BASE="<url> [url...]" does the same, but
                                  only when sc already runs as root (sudo's env_reset
                                  drops it otherwise) — prefer --mirror
  update-interval <freq|show>  Set the auto-update cadence
                                presets: hourly / daily / weekly / monthly
                                custom: any systemd OnCalendar expression
                                show: print current cadence and next run
  log [-f]                    Show logs (-f to follow, Ctrl+C to exit)
  reload                      Regenerate config and restart the service
  lang <en|zh>                Switch CLI language
  uninstall                   Uninstall singbox-cli (optionally remove the sing-box binary)
  help                        Show this help

EXAMPLES
  sc add 'vless://uuid@host:443?security=reality&pbk=...&sni=...&fp=chrome&flow=xtls-rprx-vision#LosAngeles-US'
  sc ls
  sc use US                   # or: sc use 1
  sc mode global
  sc update-interval daily             # update rulesets every day
  sc update-interval 'Mon *-*-* 04:00:00'   # every Monday at 04:00
  sc update-interval show              # show current cadence
  sc status

Hint: share links contain ? & # — wrap the entire link in single quotes
"""

HELP_ZH = """sc —— sing-box 命令行管理工具

用法
  sc <命令> [参数]

命令
  ls                          列出所有节点（● 表示当前激活）
  now                         显示当前激活节点
  use <名称|序号|auto>        切换激活节点（通过 Clash API 即时生效，不重启）
                                auto = 自动选择组：由 sing-box 探测所有节点，
                                       自动把流量切到响应最快的那个
  add <分享链接>              从分享链接添加节点
