#!/usr/bin/env python3
"""sc — sing-box CLI manager. Run `sc help` for usage."""
import argparse
import base64
import copy
import hashlib
import http.client
import json
import os
import shutil
import socket
import stat
import subprocess
import sys
import tempfile
import time
import urllib.parse
import urllib.request
from pathlib import Path

# ============ Paths ============
CFG_DIR = Path("/etc/sing-box")
CFG_PATH = CFG_DIR / "config.json"
NODES_PATH = CFG_DIR / "nodes.json"
SETTINGS_PATH = CFG_DIR / "settings.json"
RULES_DIR = CFG_DIR / "rules"
# The user's own configuration fragment, applied last over everything sc composes.
# USER-OWNED: sc never creates it, never writes it, never deletes it — which is exactly
# why a hand-edit made here survives `sc reload` / `use` / `add` and re-running install.sh,
# while a hand-edit to config.json does not.
OVERRIDE_PATH = CFG_DIR / "override.json"
# What sc last generated, as a sha256 hex digest of config.json — never a copy of it, so
# no second set of credential bytes reaches disk. Lives under CFG_DIR rather than
# /var/lib/sing-box because _init_files() hard-codes that directory as a Path literal, so
# it is the one place a redirected-paths test harness cannot repoint; uninstall.sh removes
# /etc/sing-box/ wholesale, so this leaves no residue either way.
STATE_PATH = CFG_DIR / ".config.sha256"
# THE mode of every credential document this tool writes. Single definition; the only
# reader today is _write_private(). Precedent for a named single-reader constant:
# SRS_MIN_BYTES below.
CRED_MODE = 0o600
LIB_DIR = Path("/usr/local/lib/singbox-cli")
SERVICE = "sing-box"
# THE name of this project's TUN device. One definition, three consumers:
# generate_config()'s inbound, `sc status`'s `ip addr show`, and `sc doctor`'s S5.
# Renaming the device must stay a one-line edit — a probe left on the old name would
# report a false PROBLEM on a perfectly healthy host.
TUN_IFACE = "sb-tun"
# THE tag of the auto-select group — the `urltest` outbound that probes every node and
# routes to the fastest responding one. One definition; every consumer reads this name and
# no consumer spells the literal. Deliberately language-neutral: tags live in config.json,
# so `sc lang` must not be able to move it.
AUTO_TAG = "auto"
# The outbound tags `sc` emits itself. No node may carry one of these — two outbounds with
# the same tag is a config sing-box rejects, and an ambiguous `sc use` besides. Built FROM
# AUTO_TAG so that constant stays the single definition.
RESERVED_TAGS = frozenset(("proxy", "direct", AUTO_TAG))
# THE one source of the host's IPv6 address state. Kernel-owned, read-only, and cheap:
# one small read answers "does this host hold a global IPv6 address" without a second
# system query or a second failure mode. Referenced only INSIDE function bodies, so it
# joins the seven repointable path constants as the eighth (docs/dev-map.md) — without
# that, the auto decision cannot be driven from a fixture without root.
IF_INET6_PATH = Path("/proc/net/if_inet6")
# The Clash API only ever talks to `sc` itself over loopback, so the exact port
# is irrelevant — we auto-probe a free one in a high range to avoid clashing
# with other local services (xray / clash / cockpit all default to 9090). Once
# chosen, the port is persisted in settings.json and reused verbatim so it never
# flaps across restarts.
CLASH_PORT_BASE = 29090
CLASH_PORT_SPAN = 100
SB_BIN = "sing-box"  # PATH lookup; installer places it at /usr/local/bin/sing-box

# Runtime init-system detection (evaluated once at import time)
SYSTEMD = bool(shutil.which("systemctl"))
OPENRC  = bool(shutil.which("rc-service"))

# OpenRC periodic directories for ruleset auto-update scheduling
PERIODIC_DIRS = {
    "daily":   Path("/etc/periodic/daily"),
    "weekly":  Path("/etc/periodic/weekly"),
    "monthly": Path("/etc/periodic/monthly"),
}
PERIODIC_SCRIPT = "singbox-update-rules"

# ============ Rule-set constants ============
# A *usable rule-set* is a .srs file that exists, carries the SRS magic and meets
# SRS_MIN_BYTES. That is the single condition config generation and the downloader
# both consult — deliberately not "present" / "downloaded" / "available".
SRS_MAGIC = b"SRS"
# The floor only has to exclude empty / stub bodies: the magic check rejects error
# pages and the Content-Length equality check catches truncation. It MUST stay
# strictly below the smallest real rule-set (geosite-private is a handful of
# suffixes) — a floor that rejects a correctly downloaded file would re-create the
# very bug this exists to remove. Never raise it without measuring the real files.
SRS_MIN_BYTES = 16
# THE staleness threshold, and its only reader is `sc doctor`'s rule-set section. 60 days
# is strictly greater than the longest cadence `sc update-interval` offers as a preset
# (monthly), so no host whose auto-update is working can ever trip it; it is deliberately
# NOT derived from settings["update_interval"], because a custom OnCalendar expression is
# not convertible to a duration. Age itself stays a fact (_age_text) — this is the one
# place a verdict is put on top of it.
RULESET_STALE_DAYS = 60

# (installed filename, path relative to a base). A tuple of pairs, not a dict: this
# order is the emission order of route.rule_set and must not depend on dict ordering.
RULESET_FILES = (
    ("geoip-cn.srs",        "geoip/cn.srs"),
    ("geosite-cn.srs",      "geosite/cn.srs"),
    ("geosite-google.srs",  "geosite/google.srs"),
    ("geosite-private.srs", "geosite/private.srs"),
)
# Tried in order until one yields a body that passes validation.
RULESET_BASES = (
    "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo",
    "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo",
    "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo",
    "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo",
)
# Keys of a routing rule that answer rather than match. A rule whose only matcher
# was a rule_set reference is dropped once that reference is gone.
RULE_ANSWER_KEYS = frozenset(("outbound", "server", "action", "rcode"))

# ============ Auto-elevate ============
if os.geteuid() != 0:
    os.execvp("sudo", ["sudo", "/usr/local/bin/sc"] + sys.argv[1:])


