                                退出码 0 = 九项全部正常
                                退出码 1 = 至少一项异常
                                退出码 2 = 没有异常，但至少一项未知
  config                      打印 /etc/sing-box/config.json，节点凭据已隐去
                                全程只读 —— 不写文件、不碰服务
                                被隐去的值显示为 ******（键名本身照常显示）
                                配置文档写到标准输出，这几行说明写到标准错误
  mode <rule|global|direct>   切换路由模式（即时生效）
                                rule   = 按规则分流（默认）
                                global = 全部走代理
                                direct = 全部直连
  telemetry <block|allow|show>  对固定的遥测域名清单直接返回「域名不存在」
                                block = 本地拦截，不向任何解析器查询（默认）
                                show  = 显示当前设置以及清单中的每个域名
  default-tun <on|off>        单独控制开机是否自启 sing-box
  update-rules [--mirror URL] 立即更新 .srs 规则集文件（按顺序尝试多个镜像，
                              每次下载都先校验再安装）
                                --mirror URL  用该基地址替代内置镜像列表；可重复出现，
                                              单个值也可写多个以空格分隔的 URL
                                环境变量 SB_RULES_BASE="<url> [url...]" 效果相同，但仅在
                                  sc 已以 root 运行时有效（否则会被 sudo 的 env_reset
                                  清除）—— 推荐用 --mirror
  update-interval <频率|show>  设置规则集自动更新频率
                                预设：hourly / daily / weekly / monthly
                                自定义：任意 systemd OnCalendar 表达式
                                show：查看当前频率和下次执行时间
  log [-f]                    查看日志（-f 实时跟随，Ctrl+C 退出）
  reload                      重新生成配置并重启服务
  lang <en|zh>                切换 CLI 语言
  version                     打印本次构建的版本号（不读文件、不写文件）
  uninstall                   卸载 singbox-cli（可选移除 sing-box 二进制）
  help                        显示本帮助

示例
  sc add 'vless://uuid@host:443?security=reality&pbk=...&sni=...&fp=chrome&flow=xtls-rprx-vision#美国洛杉矶'
  sc ls
  sc use 美国                 # 或 sc use 1
  sc ping                     # 立即测量所有节点
  sc export /root/nodes-backup.json
  sc import /root/nodes-backup.json
  sc mode global
  sc update-interval daily             # 改为每天更新规则集
  sc update-interval 'Mon *-*-* 04:00:00'   # 每周一凌晨 4 点
  sc update-interval show              # 查看当前频率
  sc status

提示：分享链接中含有 ? & # 等字符，整个链接必须用单引号包起来
"""


def cmd_version(args):
    """`sc version` — which build this is, as one bare line.

    Untranslated and unadorned on purpose: the output is meant to be pasted into a bug
    report and read by a script, so it carries no label a language could move. Reads no
    file, opens no socket, and main() keeps it off the writing start-up path.
    """
    print("sc " + SC_VERSION)


def cmd_help(args):
    print(HELP_ZH if LANG == "zh" else HELP_EN)


def main():
    global LANG, CLASH_PORT
    # Before anything reads a path, opens a socket or prints: the whole process is
    # replaced when this file is not already running as root, so every statement below
    # runs exactly once, as root. Importing this module reaches none of it.
    _elevate()
    # THE stdout configuration — one statement, one place, before anything can print
    # (argparse's own -h included): line buffering, backslashreplace, an explicit newline,
    # the stream's own encoding preserved rather than forced, io.TextIOWrapper rather than
    # 3.7's reconfigure(), and the guard for `sc config >&-`. backslashreplace buys an
    # unkillable stdout at the price of mangling a character the terminal's encoding cannot
    # carry; an io.StringIO stand-in certifies neither guarantee, since it shares no
    # buffering or encoding path with the real fd 1.
    if getattr(sys.stdout, "buffer", None) is not None:
        sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding=sys.stdout.encoding,
                                      errors="backslashreplace", newline="\n",
                                      line_buffering=True)
    parser = argparse.ArgumentParser(prog="sc", add_help=False)
    sub = parser.add_subparsers(dest="cmd")
    sub.add_parser("ls"); sub.add_parser("now")
    p = sub.add_parser("use"); p.add_argument("spec")
    p = sub.add_parser("add"); p.add_argument("url", nargs="?")
    p = sub.add_parser("rm"); p.add_argument("spec")
    p = sub.add_parser("ping"); p.add_argument("spec", nargs="?")
    p = sub.add_parser("export"); p.add_argument("path")
    p = sub.add_parser("import"); p.add_argument("path")
    sub.add_parser("on"); sub.add_parser("off"); sub.add_parser("status")
    sub.add_parser("doctor")
    sub.add_parser("config")
    p = sub.add_parser("mode"); p.add_argument("mode")
    p = sub.add_parser("telemetry"); p.add_argument("value")
    p = sub.add_parser("default-tun"); p.add_argument("value")
    p = sub.add_parser("update-rules")
    p.add_argument("--mirror", action="append", default=None)
    p = sub.add_parser("update-interval"); p.add_argument("value")
    p = sub.add_parser("log"); p.add_argument("-f", "--follow", action="store_true")
    sub.add_parser("reload"); sub.add_parser("uninstall")
    p = sub.add_parser("lang"); p.add_argument("value")
    sub.add_parser("version"); sub.add_parser("help")

    args = parser.parse_args()
    # The start-up path WRITES: _init_files() creates /etc/sing-box, /etc/sing-box/rules
    # and /var/lib/sing-box and seeds nodes.json / settings.json, and _resolve_clash_port()
    # persists a freshly probed port on first run. Two commands must reach neither.
    # `doctor`: on a broken or fresh host the emptiness of those very paths IS the
    # diagnosis, and a diagnostic that creates them destroys the evidence it was run to
    # collect. `config`: it shows the document on disk and writes nothing anywhere, on any
    # host state — including a host where /etc/sing-box does not exist, where creating the
    # directory would answer "no file at ..." by fabricating its container.
    # `version`: it prints a constant compiled into this file. There is no host state it
    # could need, so creating /etc/sing-box and probing for a free port to answer it would
    # be pure side effect — and it is the one command a user runs to find out what they
    # have BEFORE deciding to install or upgrade anything.
    # This is a positive opt-out naming those THREE commands: every other command —
    # including every command added later — takes the else arm with no action by anyone,
    # so the failure mode of forgetting this mechanism is "a new read-only command wrote
    # files", never "an existing command lost its initialisation".
    if args.cmd in ("doctor", "config", "version"):
        LANG = _load_lang()     # reads settings.json, tolerates its absence, writes nothing
    else:
        _init_files()
        LANG = _load_lang()
        CLASH_PORT = _resolve_clash_port()
    handlers = {
        "ls": cmd_ls, "now": cmd_now, "use": cmd_use, "add": cmd_add, "rm": cmd_rm,
        "ping": cmd_ping, "export": cmd_export, "import": cmd_import,
        "on": cmd_on, "off": cmd_off, "status": cmd_status, "doctor": cmd_doctor,
        "config": cmd_config,
        "mode": cmd_mode, "telemetry": cmd_telemetry,
        "default-tun": cmd_default_tun,
        "update-rules": cmd_update_rules, "update-interval": cmd_update_interval,
        "log": cmd_log, "reload": cmd_reload, "uninstall": cmd_uninstall,
        "lang": cmd_lang, "version": cmd_version,
        "help": cmd_help, None: cmd_help,
    }
    try:
        handlers.get(args.cmd, cmd_help)(args)
    except OverrideError as e:
        # THE one rendering site for any unusable document, not just the user's. Assembling
        # the whole sentence here and passing it through _plain() ONCE is what makes the
        # non-TTY contract true for every foreign fragment inside it (a key name, an
        # anchor, an OS message) without a _plain() call at each raise site. The newline
        # collapse is separate on purpose: _plain() removes CR and CSI sequences but not
        # \n, and a JSON key may legally contain one — `sc reload` output is captured
        # into the install log, which wants one complete line per fact.
        # WHICH path is named is decided at the raise site, by e.path: OVERRIDE_PATH at
        # every site handling the USER's document, and the class default None — rendered
        # as CFG_PATH here — for a failure inside an overlay sc itself authored. So a
        # fault sc caused is never reported as a fault in the user's file, and no
        # exception taxonomy is needed to say so.
        sys.exit(_plain(t("Cannot use {path}: {problem}",
                          path=e.path or CFG_PATH,
                          problem=str(e)).replace("\n", " ")))


if __name__ == "__main__":
    main()
