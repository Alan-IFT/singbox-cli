        "rules": [
            {"server": "hosts_dns", "ip_accept_any": True},
            {"server": "remote_dns", "clash_mode": "Global"},
            {"server": "direct_dns", "clash_mode": "Direct"},
            # The suppressed-query-type rule USED to sit here. It is emitted by
            # _dns_overlay() at index 0 instead — after these two clash_mode rules it
            # disappeared in exactly the two modes people switch to when something is
            # broken. One definition, one position; do not re-add a copy here.
            {"server": "remote_dns", "rule_set": ["geosite-google"]},
            {"server": "direct_dns", "rule_set": ["geosite-private"]},
            {"server": "direct_dns", "domain_suffix": [
                "alidns.com", "doh.pub", "dot.pub", "360.cn", "onedns.net"]},
