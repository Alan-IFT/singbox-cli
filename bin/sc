LANG = "en"  # populated in main() after _init_files()
CLASH_PORT = CLASH_PORT_BASE  # re-resolved in main() via _resolve_clash_port()


def _load_lang():
    try:
        return json.loads(SETTINGS_PATH.read_text()).get("lang", "en")
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return "en"


def _free_port(base, span):
    """First free loopback TCP port in [base, base+span); falls back to base."""
    for port in range(base, base + span):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            try:
                s.bind(("127.0.0.1", port))
                return port
            except OSError:
                continue
    return base


def _saved_clash_port():
    """The Clash API port recorded in settings.json, or None if none is recorded.

    THE single reader of settings["clash_api_port"]: it reads, never probes and never
    writes. `sc doctor` consumes exactly this — probing would return a port that is free
    *by construction* and then report it unreachable, which is a tautology, and
    persisting it would make a diagnostic invent the state it is diagnosing.
    """
    try:
        settings = load_settings()
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None
    port = settings.get("clash_api_port")
    return port if isinstance(port, int) and 1 <= port <= 65535 else None


def _resolve_clash_port():
    """Clash API port: auto-probed once, then persisted in settings.json.

    A value already present in settings is always honored (manual pin); only the
    first run on a fresh install probes for a free high port. Reusing the saved
    value verbatim means the port never flaps across restarts — even though our
    own sing-box then holds it.
    """
    port = _saved_clash_port()
    if port is not None:
        return port
    port = _free_port(CLASH_PORT_BASE, CLASH_PORT_SPAN)
    # Re-load and MERGE. save_settings() rewrites the whole file, so persisting a fresh
    # single-key dict here would erase lang / mode / default_tun / update_interval on
    # every install that predates the port auto-probe — the exact hosts this branch runs on.
    try:
        settings = load_settings()
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        settings = {}
    settings["clash_api_port"] = port
    try:
        save_settings(settings)
    except OSError:
        pass
    return port


def _egress_ip():
    """The public egress address as text, from THE one endpoint sc queries.

    Raises on failure — the caller decides how to render it. The endpoint literal and the
    8 s socket timeout live here and nowhere else, so `sc status` and `sc doctor` can never
    report different egress addresses on the same machine. Deliberately byte-faithful: the
    value is printed verbatim by `sc status`, so no scrubbing happens in here.
    """
    with urllib.request.urlopen("https://api.ipify.org", timeout=8) as resp:
        return resp.read().decode()


def t(s, **kwargs):
    msg = TRANSLATIONS.get(LANG, {}).get(s, s)
    return msg.format(**kwargs) if kwargs else msg


# ============ State files ============

def _init_files():
    CFG_DIR.mkdir(parents=True, exist_ok=True)
    RULES_DIR.mkdir(parents=True, exist_ok=True)
    Path("/var/lib/sing-box").mkdir(parents=True, exist_ok=True)
    if not NODES_PATH.exists():
        NODES_PATH.write_text(json.dumps({"active": None, "nodes": []}, indent=2))
        os.chmod(NODES_PATH, 0o600)
    if not SETTINGS_PATH.exists():
        SETTINGS_PATH.write_text(json.dumps(
            {"default_tun": True, "mode": "rule", "lang": "en"}, indent=2))


def load_nodes():
    return json.loads(NODES_PATH.read_text())


def save_nodes(d):
    NODES_PATH.write_text(json.dumps(d, indent=2, ensure_ascii=False))
    os.chmod(NODES_PATH, 0o600)


def load_settings():
    return json.loads(SETTINGS_PATH.read_text())


def save_settings(d):
    SETTINGS_PATH.write_text(json.dumps(d, indent=2))


# ============ Share-URL parsers ============

def _q(qs, key, default=None):
    return qs.get(key, [default])[0] if qs else default


def _b64dec(s):
    s = s + "=" * ((4 - len(s) % 4) % 4)
    return base64.urlsafe_b64decode(s).decode("utf-8", errors="replace")


def _name(frag, host, port):
    return urllib.parse.unquote(frag) if frag else f"{host}:{port}"


def _attach_transport(out, qs):
    net = _q(qs, "type", "tcp")
    if net == "ws":
        out["transport"] = {"type": "ws", "path": _q(qs, "path", "/")}
        h = _q(qs, "host")
        if h:
            out["transport"]["headers"] = {"Host": h}
    elif net == "grpc":
        out["transport"] = {
            "type": "grpc",
            "service_name": _q(qs, "serviceName", _q(qs, "path", "")),
        }
    elif net in ("h2", "http"):
        out["transport"] = {"type": "http"}
        h = _q(qs, "host")
        if h:
            out["transport"]["host"] = h.split(",")
        p = _q(qs, "path")
        if p:
            out["transport"]["path"] = p
    elif net == "httpupgrade":
        out["transport"] = {"type": "httpupgrade", "path": _q(qs, "path", "/")}
        h = _q(qs, "host")
        if h:
            out["transport"]["host"] = h


def _attach_tls(out, qs, host, default_sni=None):
    sec = _q(qs, "security", "none")
    if sec not in ("tls", "reality"):
        return
    sni = _q(qs, "sni") or _q(qs, "host") or default_sni or host
    tls = {"enabled": True, "server_name": sni}
    alpn = _q(qs, "alpn")
    if alpn:
        tls["alpn"] = alpn.split(",")
    fp = _q(qs, "fp")
    if fp:
        tls["utls"] = {"enabled": True, "fingerprint": fp}
    if _q(qs, "allowInsecure") in ("1", "true"):
        tls["insecure"] = True
    if sec == "reality":
        if not fp:
            tls["utls"] = {"enabled": True, "fingerprint": "chrome"}
        tls["reality"] = {"enabled": True, "public_key": _q(qs, "pbk", "")}
        sid = _q(qs, "sid")
        if sid:
            tls["reality"]["short_id"] = sid
    out["tls"] = tls


def parse_vless(url):
    p = urllib.parse.urlparse(url)
    qs = urllib.parse.parse_qs(p.query)
    out = {
        "type": "vless",
        "tag": _name(p.fragment, p.hostname, p.port),
        "server": p.hostname,
        "server_port": p.port,
        "uuid": p.username,
    }
    flow = _q(qs, "flow")
    if flow:
        out["flow"] = flow
    pe = _q(qs, "packetEncoding", "xudp")
    if pe and pe != "none":
        out["packet_encoding"] = pe
    _attach_transport(out, qs)
    _attach_tls(out, qs, p.hostname)
    return out


def parse_vmess(url):
    payload = url[len("vmess://"):]
    cfg = json.loads(_b64dec(payload))
    host = cfg["add"]
    port = int(cfg["port"])
    out = {
        "type": "vmess",
        "tag": cfg.get("ps") or f"{host}:{port}",
        "server": host,
        "server_port": port,
        "uuid": cfg["id"],
        "alter_id": int(cfg.get("aid", 0)),
        "security": cfg.get("scy", "auto"),
    }
    net = cfg.get("net", "tcp")
    if net == "ws":
        out["transport"] = {"type": "ws", "path": cfg.get("path", "/")}
        if cfg.get("host"):
            out["transport"]["headers"] = {"Host": cfg["host"]}
    elif net == "grpc":
        out["transport"] = {"type": "grpc", "service_name": cfg.get("path", "")}
    elif net in ("h2", "http"):
        out["transport"] = {"type": "http"}
        if cfg.get("host"):
            out["transport"]["host"] = cfg["host"].split(",")
        if cfg.get("path"):
            out["transport"]["path"] = cfg["path"]
    if cfg.get("tls") == "tls":
        sni = cfg.get("sni") or cfg.get("host") or host
        tls = {"enabled": True, "server_name": sni}
        if cfg.get("alpn"):
            tls["alpn"] = cfg["alpn"].split(",")
        if cfg.get("fp"):
            tls["utls"] = {"enabled": True, "fingerprint": cfg["fp"]}
        out["tls"] = tls
    return out


def parse_trojan(url):
    p = urllib.parse.urlparse(url)
    qs = urllib.parse.parse_qs(p.query)
    out = {
        "type": "trojan",
        "tag": _name(p.fragment, p.hostname, p.port or 443),
        "server": p.hostname,
        "server_port": p.port or 443,
        "password": urllib.parse.unquote(p.username or ""),
    }
    if "security" not in qs:
        qs["security"] = ["tls"]
    _attach_tls(out, qs, p.hostname)
    _attach_transport(out, qs)
    return out


def parse_ss(url):
    body = url[len("ss://"):]
    name = ""
    if "#" in body:
        body, frag = body.split("#", 1)
        name = urllib.parse.unquote(frag)
    if "@" in body:
        userinfo, hostpart = body.rsplit("@", 1)
        try:
            decoded = _b64dec(userinfo)
            method, password = decoded.split(":", 1)
        except Exception:
            method, password = userinfo.split(":", 1)
        if "?" in hostpart:
            hostpart = hostpart.split("?", 1)[0]
        host, port = hostpart.rsplit(":", 1)
    else:
        decoded = _b64dec(body)
        method_pwd, hostpart = decoded.rsplit("@", 1)
        method, password = method_pwd.split(":", 1)
        host, port = hostpart.rsplit(":", 1)
    return {
        "type": "shadowsocks",
        "tag": name or f"{host}:{port}",
        "server": host,
        "server_port": int(port),
        "method": method,
        "password": urllib.parse.unquote(password),
    }


def parse_hy2(url):
    p = urllib.parse.urlparse(url)
    qs = urllib.parse.parse_qs(p.query)
    out = {
        "type": "hysteria2",
        "tag": _name(p.fragment, p.hostname, p.port or 443),
        "server": p.hostname,
        "server_port": p.port or 443,
        "password": urllib.parse.unquote(p.username or ""),
    }
    sni = _q(qs, "sni") or p.hostname
    tls = {"enabled": True, "server_name": sni, "alpn": ["h3"]}
    alpn = _q(qs, "alpn")
    if alpn:
        tls["alpn"] = alpn.split(",")
    if _q(qs, "insecure") in ("1", "true"):
        tls["insecure"] = True
    out["tls"] = tls
    obfs = _q(qs, "obfs")
    if obfs:
        out["obfs"] = {"type": obfs, "password": _q(qs, "obfs-password", "")}
    return out


def parse_tuic(url):
    p = urllib.parse.urlparse(url)
    qs = urllib.parse.parse_qs(p.query)
    userinfo = p.username or ""
    if ":" in userinfo:
        uuid, password = userinfo.split(":", 1)
        password = urllib.parse.unquote(password)
    else:
        uuid, password = userinfo, ""
    out = {
        "type": "tuic",
        "tag": _name(p.fragment, p.hostname, p.port or 443),
        "server": p.hostname,
        "server_port": p.port or 443,
        "uuid": uuid,
        "password": password,
    }
    cc = _q(qs, "congestion_control")
    if cc:
        out["congestion_control"] = cc
    udp_mode = _q(qs, "udp_relay_mode", "native")
    if udp_mode:
        out["udp_relay_mode"] = udp_mode
    sni = _q(qs, "sni") or p.hostname
    tls = {"enabled": True, "server_name": sni, "alpn": _q(qs, "alpn", "h3").split(",")}
    if _q(qs, "allow_insecure") in ("1", "true"):
        tls["insecure"] = True
    out["tls"] = tls
    return out


def parse_share_url(url):
    url = url.strip()
    handlers = {
        "vless://": parse_vless,
        "vmess://": parse_vmess,
        "trojan://": parse_trojan,
        "ss://": parse_ss,
        "hysteria2://": parse_hy2,
        "hy2://": parse_hy2,
        "tuic://": parse_tuic,
    }
    for scheme, fn in handlers.items():
        if url.startswith(scheme):
            return fn(url)
    raise ValueError(t("Unsupported share-link protocol: {url}", url=url[:30]))


# ============ Rule-sets ============
# One judgment of "is this rule-set usable?", consulted by config generation, by the
# downloader (before anything is installed) and by the screen renderer. Adding a second
# notion of usability anywhere else is a defect, not an optimisation.

def srs_reject_reason(head, size):
    """The one definition of an unusable rule-set body.

    head -- first bytes of the body (may be shorter than SRS_MAGIC, or empty)
    size -- total byte count of the body
    Returns None when the body is usable, else "too-small" or "bad-magic".
    Pure: no I/O, no globals beyond SRS_MAGIC / SRS_MIN_BYTES.
    """
    if size < SRS_MIN_BYTES:
        return "too-small"          # checked first, so a 0-byte body is never "bad-magic"
    if head[:len(SRS_MAGIC)] != SRS_MAGIC:
        return "bad-magic"
    return None


def ruleset_state(path):
    """Three facts about one rule-set file, from ONE read: (status, digest, size).

    status -- exactly one of "usable" | "absent" | "bad-magic" | "too-small" | "unreadable",
              decided by srs_reject_reason() and by nothing else.
    digest -- sha256 hex of the file's FULL content, or None.
    size   -- the byte count of that same read, or None.

    DIGEST CONTRACT (binding — changed_usable_tags() is only correct because of it):

        size is None <=> digest is None  <=>  no complete read happened
                                         <=>  status in {"absent", "unreadable"}

    So a file read to EOF without error ALWAYS carries a real digest AND a real size,
    including a readable EMPTY file: ("too-small", sha256(b"").hexdigest(), 0), because
    zero bytes *were* read successfully. An OSError at any point — before or after N bytes
    — yields ("unreadable", None, None) and NEVER a partial digest or a partial size, which
    would be a content claim about bytes that were never fully read. None is therefore not
    a content value: two Nones are NOT "the same content", and changed_usable_tags() relies
    on that.

    Never raises, never writes. Reads in 65536-byte chunks, so memory does not scale with
    file size, and `size` is the real byte count rather than st_size — which is why it is
    returned rather than discarded: `sc doctor` prints the size that the very same read
    decided the status from, so the report cannot contradict itself.
    """
    head = b""
    size = 0
    digest = hashlib.sha256()
    try:
        if not path.exists():
            # A dangling symlink does not exist, but it is broken rather than absent.
            return ("unreadable", None, None) if path.is_symlink() else ("absent", None, None)
        if not path.is_file():
            return ("unreadable", None, None)   # a directory, a fifo, ...
        with path.open("rb") as fh:
            while True:
                chunk = fh.read(65536)      # same chunk size as _fetch_to_temp
                if not chunk:
                    break
                digest.update(chunk)
                size += len(chunk)
                if len(head) < len(SRS_MAGIC):
                    # Accumulate: a first read shorter than the magic is legal.
                    head = (head + chunk)[:len(SRS_MAGIC)]
    except OSError:
        # a partial digest and a partial size are never returned
        return ("unreadable", None, None)
    return (srs_reject_reason(head, size) or "usable", digest.hexdigest(), size)


def ruleset_status(path):
    """Usability of one rule-set file — the status-only view of ruleset_state().

    Returns exactly one of: "usable" | "absent" | "bad-magic" | "too-small" | "unreadable".

    Has no in-tree caller today: both remaining questions (the report and update-rules'
    before/after snapshots) need the digest as well and go through ruleset_states().
    Retained deliberately as the named per-file adapter of the single usability judgment
    (docs/dev-map.md) — the thing to call instead of forming a second opinion with
    path.exists() when only the status of one file is wanted.
    """
    return ruleset_state(path)[0]


def ruleset_states():
    """[(tag, filename, status, digest, size), ...] per rule-set, in RULESET_FILES order.

    THE snapshot: cmd_update_rules takes exactly one before the downloads and one after
    them, and answers both "which rule-sets became usable" and "whose bytes really changed"
    from the same bytes; `sc doctor` takes one and answers "what is on disk right now",
    size included. tag is the filename without ".srs" — the exact tag the config uses.
    Pure query: no network, no service, no config; creates, modifies and deletes nothing.
    """
    states = []
    for fname, _relpath in RULESET_FILES:
        tag = fname[:-4] if fname.endswith(".srs") else fname
        status, digest, size = ruleset_state(RULES_DIR / fname)
        states.append((tag, fname, status, digest, size))
    return states


def _status_view(states):
    """[(tag, filename, status), ...] projection of a ruleset_states() result.

    generate_config() and usable_tags() destructure 3-tuples; this keeps both untouched,
    and it is where a widening of the snapshot tuple stops.
    """
    return [(tag, fname, status) for tag, fname, status, _digest, _size in states]


def ruleset_report():
    """[(tag, filename, status), ...] for every known rule-set, in RULESET_FILES order.

    tag is the filename without ".srs" — the exact tag the config uses. Pure query: no
    network, no service, no config; creates, modifies and deletes nothing.
    """
    return _status_view(ruleset_states())


def changed_usable_tags(before, after):
    """Sorted tags that are usable in `after` AND whose content differs from `before`.

    Both arguments are ruleset_states() results. This is the apply set — the single
    "must sing-box re-read anything?" answer for a whole run. Pure: no I/O, no globals.

    Paired BY TAG through dicts, never by list index. Both snapshots iterate RULESET_FILES
    today, so positional pairing happens to work; it would become a silent mis-pairing the
    moment that tuple changes.

    The "usable in after" half is not decoration: a rule-set corrupted or deleted mid-run by
    an external actor is a LOSS, not a change, and restarting *for it* would make sing-box
    re-read a file it cannot parse — the start-up failure the degradation work removed.
    Whatever we restart for, we restart only for a file sing-box will actually load.
    """
    old = dict((tag, digest) for tag, _fname, _status, digest, _size in before)
    changed = []
    for tag, _fname, status, digest, _size in after:
        if status != "usable":
            continue                    # a loss is not a change
        old_digest = old.get(tag)       # a tag absent from `before` reads as None
        # None means "those bytes were never read", never "empty" and never a content
        # value: it differs from every digest AND from another None. The None-vs-None
        # arm is unreachable for a tag usable in `after` (its digest is real, by the
        # ruleset_state contract) and is spelled out so that a later edit cannot quietly
        # make two never-read files compare equal.
        if old_digest is None or digest is None or old_digest != digest:
            changed.append(tag)
    return sorted(changed)


def usable_tags(report):
    """Set of tags whose status is "usable"."""
    return set(tag for tag, _fname, status in report if status == "usable")


def _status_text(status):
    """Bilingual phrase for a rule-set status. Must stay a function: LANG is assigned
    in main() after import, so a module-level dict of t() values would freeze English.

    "usable" is here for `sc doctor`, which renders healthy rows too; the degradation
    warning and its callers only ever pass non-usable statuses, so their output is
    unchanged. This is the one status vocabulary — doctor adds no second one.
    """
    return {
        "usable": t("usable"),
        "absent": t("missing"),
        "bad-magic": t("not a rule-set file"),
        "too-small": t("file too small"),
        "unreadable": t("unreadable"),
    }.get(status, status)


def _filter_rules(rules, usable):
    """Return the rules that survive, with every reference to a rule-set outside
    `usable` removed. Surviving rules are mutated in place (JSON key order preserved).

    Called for BOTH dns.rules and route.rules with the same `usable` set, so a dangling
    reference is structurally impossible in either array.
    """
    kept = []
    for rule in rules:
        tags = rule.get("rule_set")
        if not tags:
            kept.append(rule)
            continue
        alive = [tag for tag in tags if tag in usable]
        if len(alive) == len(tags):
            kept.append(rule)
        elif alive:
            rule["rule_set"] = alive
            kept.append(rule)
        elif any(k != "rule_set" and k not in RULE_ANSWER_KEYS for k in rule):
            # Still matches on something else: drop only the reference, keep the rule.
            # CAUTION: a sing-box rule ANDs its matchers, so the survivor matches MORE
            # than the original did (e.g. {network: udp, rule_set: X} becomes "all udp").
            # Mandated behaviour, and dead for today's config — every rule-set rule here
            # carries no other matcher. Adding a mixed-matcher rule broadens it silently.
            del rule["rule_set"]
            kept.append(rule)
        # else: nothing left to match on — drop the whole rule, degrade toward `final`.
    return kept


def _warn_degraded(report):
    """Emit the bilingual degradation warning on stderr. No-op when nothing is unusable."""
    bad = [(tag, status) for tag, _fname, status in report if status != "usable"]
    if not bad:
        return
    names = ", ".join("%s (%s)" % (tag, _status_text(status)) for tag, status in bad)
    if len(bad) == len(report):
        msg = t("{n}/{total} rule-sets unusable ({names}) — degraded to no-splitting mode: "
                "all traffic uses the default outbound. Run `sc update-rules` (or `sc reload` "
                "once the files are in place) to restore.",
                n=len(bad), total=len(report), names=names)
    else:
        msg = t("{n}/{total} rule-sets unusable ({names}) — the rules referencing them were "
                "skipped; the remaining rule-sets still apply. Run `sc update-rules` (or "
                "`sc reload` once the files are in place) to restore.",
                n=len(bad), total=len(report), names=names)
    sys.stderr.write("⚠️  " + msg + "\n")


def _ruleset_bases(mirror_values):
    """Effective base list. --mirror (repeatable, whitespace-splittable) beats
    SB_RULES_BASE; either REPLACES the built-in list; a whitespace-only override counts
    as absent."""
    override = []
    for value in (mirror_values or []):
        override.extend(value.split())
    if not override:
        override = os.environ.get("SB_RULES_BASE", "").split()
    return override or list(RULESET_BASES)


def _temp_path(fname):
    """This invocation's temp path for one rule-set — unique per process, so the weekly
    timer and a manual run cannot corrupt each other's transfer."""
    return RULES_DIR / (fname + ".tmp." + str(os.getpid()))


def _clear_stale_temps(fname):
    """Remove this rule-set's leftover temp files from earlier runs.

    A temp whose pid suffix belongs to a live process (a concurrent `sc update-rules`)
    is left alone. An absent or non-integer suffix — which includes the legacy fixed
    `<name>.tmp` written by older versions — counts as stale and is removed.
    """
    prefix = fname + ".tmp"
    try:
        entries = list(RULES_DIR.iterdir())
    except OSError:
        return
    for path in entries:
        name = path.name
        if name != prefix and not name.startswith(prefix + "."):
            continue
        alive = False
        if name != prefix:
            try:
                pid = int(name[len(prefix) + 1:])
            except ValueError:
                pid = -1                      # unparseable suffix ⇒ stale
            if pid > 0 and pid != os.getpid():
                try:
                    os.kill(pid, 0)
                    alive = True              # a concurrent run owns it
                except ProcessLookupError:
                    alive = False
                except OSError:
                    alive = True              # exists but not ours (EPERM)
        if alive:
            continue
        try:
            path.unlink()
        except OSError:
            pass


def _fetch_to_temp(url, tmp, prefix, tty):
    """Stream `url` into `tmp` in 64 KiB chunks, drawing progress when tty, and validate
    the body. Returns the byte count.

    Raises on transport failure, on got != a declared Content-Length, or on any
    srs_reject_reason() rejection (message already bilingual). On a TTY the cursor is
    left at the end of a freshly redrawn `prefix` with no newline whether it returns or
    raises, so the caller prints its completion line identically in both modes.
    Never touches the rule-set's real path; the caller owns `tmp`'s removal.
    """
    try:
        got = 0
        head = b""
        with urllib.request.urlopen(url, timeout=30) as r:
            try:
                declared = int(r.headers.get("Content-Length"))
            except (TypeError, ValueError):
                declared = None       # absent or unparseable ⇒ no declared length
            if declared is not None and declared < 0:
                declared = None
            with tmp.open("wb") as fh:
                while True:
                    chunk = r.read(65536)
                    if not chunk:
                        break
                    fh.write(chunk)
                    got += len(chunk)
                    if len(head) < len(SRS_MAGIC):
                        # Accumulate: a first read shorter than the magic is legal.
                        head = (head + chunk)[:len(SRS_MAGIC)]
                    if tty:
                        if declared:
                            line = t("{done}/{total} bytes ({pct}%)", done=got,
                                     total=declared, pct=got * 100 // declared)
                        else:
                            line = t("{done} bytes", done=got)
                        sys.stdout.write("\r" + prefix + line + "\033[K")
                        sys.stdout.flush()
        if declared is not None and got != declared:
            raise ValueError(t("truncated: got {got} of {declared} bytes",
                               got=got, declared=declared))
        reason = srs_reject_reason(head, got)
        if reason:
            raise ValueError(_status_text(reason))
        return got
    finally:
        if tty:
            # Erase with \033[K rather than space padding: correct for CJK double-width
            # text and never wraps. Only ever emitted on a terminal.
            sys.stdout.write("\r" + prefix + "\033[K")
            sys.stdout.flush()


# ============ Config generation ============

def generate_config():
    nodes_data = load_nodes()
    nodes = nodes_data["nodes"]
    active = nodes_data.get("active")

    # The ONE rule-set query. The same `usable` set drives the definition list and both
    # reference arrays, so a tag can never be referenced without being defined.
    report = ruleset_report()
    usable = usable_tags(report)

    node_tags = [n["tag"] for n in nodes]
    if active not in node_tags:
        active = node_tags[0] if node_tags else None
        nodes_data["active"] = active
        save_nodes(nodes_data)

    selector = {
        "type": "selector",
        "tag": "proxy",
        "outbounds": (node_tags or []) + ["direct"],
        "default": active or "direct",
        "interrupt_exist_connections": True,
    }

    config = {
        "log": {"level": "warn", "timestamp": True},
        "dns": {
            "servers": [
                {"server": "119.29.29.29", "type": "udp", "tag": "local_local"},
                {"server": "cloudflare-dns.com", "domain_resolver": "hosts_dns",
                 "path": "/dns-query", "type": "https", "tag": "remote_dns", "detour": "proxy"},
                {"server": "119.29.29.29", "domain_resolver": "local_local",
                 "type": "udp", "tag": "direct_dns"},
                {"predefined": {
                    "dns.google": ["8.8.8.8", "8.8.4.4"],
                    "cloudflare-dns.com": ["104.16.249.249", "104.16.248.249"],
                    "one.one.one.one": ["1.1.1.1", "1.0.0.1"],
                    "dns.alidns.com": ["223.5.5.5", "223.6.6.6"],
                    "doh.pub": ["1.12.12.12", "120.53.53.53"],
                    "dot.pub": ["1.12.12.12", "120.53.53.53"],
                }, "type": "hosts", "tag": "hosts_dns"},
            ],
            "rules": [
                {"server": "hosts_dns", "ip_accept_any": True},
                {"server": "remote_dns", "clash_mode": "Global"},
                {"server": "direct_dns", "clash_mode": "Direct"},
                {"action": "predefined", "rcode": "NOERROR", "query_type": [64, 65]},
                {"server": "remote_dns", "rule_set": ["geosite-google"]},
                {"server": "direct_dns", "rule_set": ["geosite-private"]},
                {"server": "direct_dns", "domain_suffix": [
                    "alidns.com", "doh.pub", "dot.pub", "360.cn", "onedns.net"]},
                {"server": "direct_dns", "rule_set": ["geosite-cn"]},
            ],
            "final": "remote_dns",
            "independent_cache": True,
        },
        "inbounds": [
            {"type": "tun", "tag": "tun-in", "interface_name": TUN_IFACE,
             "address": ["172.19.0.1/30"], "mtu": 9000,
             "auto_route": True, "strict_route": True, "stack": "gvisor"},
        ],
        "outbounds": [selector] + nodes + [{"type": "direct", "tag": "direct"}],
        "route": {
            "default_domain_resolver": {"server": "direct_dns"},
            "auto_detect_interface": True,
            "rules": [
                {"outbound": "direct", "process_name": ["sing-box"]},
                {"action": "sniff"},
                {"protocol": ["dns"], "action": "hijack-dns"},
                {"outbound": "direct", "clash_mode": "Direct"},
                {"outbound": "proxy",  "clash_mode": "Global"},
                {"network": ["udp"], "port": [443], "action": "reject"},
                {"outbound": "proxy",  "rule_set": ["geosite-google"]},
                {"outbound": "direct", "ip_is_private": True},
                {"outbound": "direct", "rule_set": ["geosite-private"]},
                {"outbound": "direct", "domain_suffix": [
                    "alidns.com", "doh.pub", "dot.pub", "360.cn", "onedns.net"]},
                {"outbound": "direct", "rule_set": ["geoip-cn"]},
                {"outbound": "direct", "rule_set": ["geosite-cn"]},
            ],
            "rule_set": [
                {"tag": tag, "type": "local", "format": "binary",
                 "path": str(RULES_DIR / fname)}
                for tag, fname, status in report if status == "usable"
            ],
            "final": "proxy",
        },
        "experimental": {
            "cache_file": {"enabled": True, "path": "/var/lib/sing-box/cache.db",
                           "store_fakeip": False},
            "clash_api": {"external_controller": f"127.0.0.1:{CLASH_PORT}"},
        },
    }

    # Degrade per file: drop every rule that references a rule-set we did not define,
    # in BOTH rule arrays. An unusable rule-set costs routing granularity, never start-up.
    if not config["route"]["rule_set"]:
        del config["route"]["rule_set"]     # an absent optional field beats an empty one
    config["dns"]["rules"] = _filter_rules(config["dns"]["rules"], usable)
    config["route"]["rules"] = _filter_rules(config["route"]["rules"], usable)
    _warn_degraded(report)

    CFG_PATH.write_text(json.dumps(config, indent=2, ensure_ascii=False))
    os.chmod(CFG_PATH, 0o600)

    r = subprocess.run([SB_BIN, "check", "-c", str(CFG_PATH)],
                       capture_output=True, text=True)
    if r.returncode != 0:
        sys.stderr.write("⚠️  " + t("Config check failed:\n{stderr}", stderr=r.stderr) + "\n")
        return False
    return True


def restart_service():
    if SYSTEMD:
        subprocess.run(["systemctl", "restart", SERVICE], check=False)
    elif OPENRC:
        subprocess.run(["rc-service", SERVICE, "restart"], check=False)


def reload_or_restart():
    if not generate_config():
        return False
    restart_service()
    return True


# ============ Clash API ============

def clash_api(method, path, data=None, port=None):
    # port=None keeps every existing call site on the port main() resolved; `sc doctor`
    # passes the persisted port explicitly, because it never resolves (and so never
    # persists) one of its own.
    url = f"http://127.0.0.1:{port or CLASH_PORT}" + path
    body = json.dumps(data).encode() if data is not None else None
    req = urllib.request.Request(url, data=body, method=method)
    if body:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=3) as r:
            text = r.read().decode()
            return json.loads(text) if text else {}
    except (urllib.error.URLError, urllib.error.HTTPError):
        return None


def is_running():
    if SYSTEMD:
        return subprocess.run(["systemctl", "is-active", "--quiet", SERVICE]).returncode == 0
    elif OPENRC:
        return subprocess.run(["rc-service", SERVICE, "status"],
                               capture_output=True).returncode == 0
    return False


# ============ Helpers ============

def _resolve_node(spec):
    nodes_data = load_nodes()
    nodes = nodes_data["nodes"]
    if not nodes:
        sys.exit(t("Error: no nodes added yet — use `sc add <link>` first"))
    try:
        idx = int(spec)
        if 1 <= idx <= len(nodes):
            return nodes_data, nodes[idx - 1]
    except ValueError:
        pass
    for n in nodes:
        if n["tag"] == spec:
            return nodes_data, n
    matches = [n for n in nodes if spec.lower() in n["tag"].lower()]
    if len(matches) == 1:
        return nodes_data, matches[0]
    if len(matches) > 1:
        names = "\n  ".join(n["tag"] for n in matches)
        sys.exit(t("Error: '{spec}' matches multiple nodes:\n  {names}", spec=spec, names=names))
    sys.exit(t("Error: no node matches '{spec}' (try `sc ls`)", spec=spec))


def _unique_tag(tag, existing):
    if tag not in existing:
        return tag
    i = 2
    while f"{tag} #{i}" in existing:
        i += 1
    return f"{tag} #{i}"


# ============ Commands ============

def cmd_ls(args):
    nodes_data = load_nodes()
    nodes = nodes_data["nodes"]
    active = nodes_data.get("active")
    if not nodes:
        print(t("(no nodes — use `sc add <link>` to add)"))
        return
    print(f"{t('ls.idx'):>4}  {t('ls.active'):2}  {t('ls.type'):10}  {t('ls.name'):30}  {t('ls.address'):25}")
    for i, n in enumerate(nodes, 1):
        marker = "●" if n["tag"] == active else " "
        addr = f"{n['server']}:{n['server_port']}"
        print(f"{i:>4}  {marker:2}  {n['type']:10}  {n['tag'][:30]:30}  {addr[:25]:25}")


def cmd_now(args):
    nodes_data = load_nodes()
    print(nodes_data.get("active") or t("(none)"))


def cmd_use(args):
    nodes_data, node = _resolve_node(args.spec)
    nodes_data["active"] = node["tag"]
    save_nodes(nodes_data)
    if is_running():
        r = clash_api("PUT", "/proxies/proxy", {"name": node["tag"]})
        if r is not None:
            print(t("Switched to: {tag}", tag=node["tag"]))
            return
    if reload_or_restart():
        print(t("Switched to: {tag} (service restarted)", tag=node["tag"]))


def cmd_add(args):
    if not args.url:
        sys.exit(t("Usage: sc add '<vless://...|vmess://...|trojan://...|ss://...|hysteria2://...|tuic://...>'\nHint: wrap the share link in single quotes"))
    try:
        outbound = parse_share_url(args.url)
    except Exception as e:
        sys.exit(t("Error: {e}", e=e))
    nodes_data = load_nodes()
    existing = {n["tag"] for n in nodes_data["nodes"]}
    outbound["tag"] = _unique_tag(outbound["tag"], existing)
    nodes_data["nodes"].append(outbound)
    if not nodes_data.get("active"):
        nodes_data["active"] = outbound["tag"]
    save_nodes(nodes_data)
    if reload_or_restart():
        print(t("Added: {tag} ({type} → {server}:{port})",
                tag=outbound["tag"], type=outbound["type"],
                server=outbound["server"], port=outbound["server_port"]))
    else:
        print(t("Added: {tag} (⚠️ config check failed — see `sc log`)", tag=outbound["tag"]))


def cmd_rm(args):
    nodes_data, node = _resolve_node(args.spec)
    nodes_data["nodes"] = [n for n in nodes_data["nodes"] if n["tag"] != node["tag"]]
    if nodes_data.get("active") == node["tag"]:
        nodes_data["active"] = nodes_data["nodes"][0]["tag"] if nodes_data["nodes"] else None
    save_nodes(nodes_data)
    reload_or_restart()
    print(t("Removed: {tag}", tag=node["tag"]))


def cmd_on(args):
    if SYSTEMD:
        subprocess.run(["systemctl", "enable", "--now", SERVICE], check=False)
    elif OPENRC:
        subprocess.run(["rc-update", "add", SERVICE, "default"], check=False)
        subprocess.run(["rc-service", SERVICE, "start"], check=False)
    settings = load_settings()
    settings["default_tun"] = True
    save_settings(settings)
    print(t("sing-box started + boot autostart enabled"))


def cmd_off(args):
    if SYSTEMD:
        subprocess.run(["systemctl", "disable", "--now", SERVICE], check=False)
    elif OPENRC:
        subprocess.run(["rc-service", SERVICE, "stop"], check=False)
        subprocess.run(["rc-update", "del", SERVICE, "default"], check=False)
    settings = load_settings()
    settings["default_tun"] = False
    save_settings(settings)
    print(t("sing-box stopped + boot autostart disabled"))


def cmd_status(args):
    print(t("=== Service status ==="))
    if SYSTEMD:
        subprocess.run(["systemctl", "status", "--no-pager", "-n", "5", SERVICE])
    elif OPENRC:
        subprocess.run(["rc-service", SERVICE, "status"])
    print("\n" + t("=== TUN interface ==="))
    subprocess.run(["ip", "-br", "addr", "show", TUN_IFACE])
    if is_running():
        nodes_data = load_nodes()
        print("\n" + t("=== Current node ==="))
        print(nodes_data.get("active") or t("(none)"))
        r = clash_api("GET", "/configs")
        print("\n" + t("=== Route mode ==="))
        print((r or {}).get("mode", t("(unavailable)")))
        print("\n" + t("=== Clash API ==="))
        print(f"127.0.0.1:{CLASH_PORT}")
        print("\n" + t("=== Egress IP ==="))
        try:
            print(_egress_ip())
        except Exception as e:
            print(t("(error: {e})", e=e))


# ============ doctor ============
# One pass, one screen, seven facts, in CAUSAL order: no section is printed before a
# section whose failure would explain it (binary and rule-sets above the config check,
# the config check above the service, the service above TUN / Clash API, those above
# egress). Nothing here forms a second opinion — every fact comes from the function that
# already owns that judgment.
#
# READ-ONLY, absolutely. `doctor` runs when the machine is already broken, so it must not
# destroy the evidence: it writes no file, touches no service, and main() keeps it off
# _init_files() / _resolve_clash_port(), the two writers on the shared start-up path.

DOCTOR_OK, DOCTOR_UNKNOWN, DOCTOR_PROBLEM = 0, 1, 2     # ordered: OK < UNKNOWN < PROBLEM
# Values are translation KEYS, resolved at print time — LANG is assigned in main(), after
# import, so a pre-rendered table would freeze English (same reason as _status_text()).
DOCTOR_MARK = {DOCTOR_OK: "OK", DOCTOR_UNKNOWN: "UNKNOWN", DOCTOR_PROBLEM: "PROBLEM"}
DOCTOR_EXIT = {DOCTOR_OK: 0, DOCTOR_UNKNOWN: 2, DOCTOR_PROBLEM: 1}
DOCTOR_MSG_LINES = 5        # at most this many verbatim lines of a checker message


def _plain(text):
    """Foreign text (a tool's output, an exception message) made safe for the non-TTY
    output contract: CR and ESC removed, trailing whitespace stripped. Never abridges.

    Everything doctor prints that it did not write itself goes through here, so "no \\r and
    no ESC in a redirected report" is a property of this code rather than a hope about
    other programs' colour detection.

    A complete CSI sequence -- ESC "[" <params 0x30-0x3F> <intermediates 0x20-0x2F>
    <final 0x40-0x7E> -- is removed WHOLE, because sing-box colours its output even into a
    pipe: `sing-box check` on a config with a missing rule-set emits, measured on 1.13.15
    with stdout=PIPE, b'\\x1b[31mFATAL\\x1b[0m[0000] initialize router: ...'. Dropping the
    ESC byte alone left the residue "[31mFATAL[0m" on the one row this report leans on.
    Only a COMPLETE sequence goes, so no real text can be eaten -- the "[0000]" above is
    logrus' elapsed-time field, not a sequence, and it survives. Other escape forms (OSC,
    charset selection) keep the older ESC-only behaviour: none has been observed from
    these tools and each needs its own terminator grammar. Scanned by hand, not with `re`,
    to keep the fix inside this function; `re` is still not imported by bin/sc.
    """
    text = text.replace("\r", "")
    if "\x1b" not in text:
        return text.rstrip()            # the common path, byte-for-byte as before
    out = []
    i = 0
    n = len(text)
    while True:
        j = text.find("\x1b", i)
        if j < 0:
            out.append(text[i:])
            break
        out.append(text[i:j])
        k = j + 1
        if text[k:k + 1] == "[":
            k += 1
            while k < n and "\x30" <= text[k] <= "\x3f":
                k += 1
            while k < n and "\x20" <= text[k] <= "\x2f":
                k += 1
            if k < n and "\x40" <= text[k] <= "\x7e":
                i = k + 1               # complete CSI: drop it entirely
                continue
        i = j + 1                       # not a complete CSI: drop the ESC byte only
    return "".join(out).rstrip()


def _doctor_run(cmd):
    """(returncode, merged stdout+stderr) of one read-only probe command.

    3.6-safe deliberately: stdout=PIPE + stderr=STDOUT + .decode(), never the 3.7-only
    convenience keywords. Merging stderr keeps a tool's diagnostics inside the report
    instead of leaking around it. OSError (a missing tool) is left to the caller, which is
    how "the tool is not installed" becomes that section's UNKNOWN row, not a traceback.
    """
    r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    return r.returncode, _plain(r.stdout.decode("utf-8", "replace"))


def _first_line(text):
    """First non-blank line of a tool's output, or ""."""
    for line in text.splitlines():
        if line.strip():
            return line
    return ""


def _doctor_binary():
    """S1 — where the sing-box binary is, and what version it reports."""
    path = shutil.which(SB_BIN)
    if not path:
        return [(DOCTOR_PROBLEM, "sing-box binary", t("not found on PATH")),
                (DOCTOR_UNKNOWN, "sing-box version", t("no sing-box binary on PATH"))]
    rows = [(DOCTOR_OK, "sing-box binary", path)]
    try:
        code, out = _doctor_run([SB_BIN, "version"])
    except OSError as e:
        rows.append((DOCTOR_UNKNOWN, "sing-box version",
                     t("cannot determine: {e}", e=_plain(str(e)))))
        return rows
    line = _first_line(out)
    if code != 0 or not line:
        rows.append((DOCTOR_UNKNOWN, "sing-box version",
                     t("the binary produced no version line (exit {code})", code=code)))
    else:
        rows.append((DOCTOR_OK, "sing-box version", line))
    return rows


def _doctor_rulesets():
    """S2 — one row per rule-set: status and size from the SAME single read.

    The head of the owner's failure chain, which is why it prints above the config check.
    """
    states = ruleset_states()
    summary_cls = DOCTOR_OK
    usable = 0
    rows = []
    for _tag, fname, status, _digest, size in states:
        if status == "usable":
            usable += 1
            cls = DOCTOR_OK
        else:
            cls = DOCTOR_PROBLEM
            summary_cls = DOCTOR_PROBLEM
        reason = _status_text(status)
        if size is None:
            # No complete read happened, so there is no honest byte count to print.
            value = t("{reason}, size unavailable", reason=reason)
        else:
            value = t("{reason}, {size} bytes", reason=reason, size=size)
        rows.append((cls, fname, value))
    summary = (summary_cls, "rule-sets",
               t("{n}/{total} usable", n=usable, total=len(states)))
    return [summary] + rows


def _doctor_config():
    """S3 — is there a config, and does the sing-box checker accept it?

    Opens the file only to learn whether it is readable: an EACCES is "cannot read", never
    "absent". A missing binary makes the check UNKNOWN — never "config invalid".
    """
    try:
        with CFG_PATH.open("rb"):
            pass
    except FileNotFoundError:
        return [(DOCTOR_PROBLEM, "configuration",
                 t("no file at {path}", path=str(CFG_PATH)))]
    except OSError as e:
        return [(DOCTOR_UNKNOWN, "configuration",
                 t("cannot read {path}: {e}", path=str(CFG_PATH), e=_plain(str(e))))]
    rows = [(DOCTOR_OK, "configuration", str(CFG_PATH))]
    if not shutil.which(SB_BIN):
        rows.append((DOCTOR_UNKNOWN, "sing-box check", t("no sing-box binary on PATH")))
        return rows
    try:
        code, out = _doctor_run([SB_BIN, "check", "-c", str(CFG_PATH)])
    except OSError as e:
        rows.append((DOCTOR_UNKNOWN, "sing-box check",
                     t("cannot determine: {e}", e=_plain(str(e)))))
        return rows
    if code == 0:
        rows.append((DOCTOR_OK, "sing-box check", t("no error reported")))
        return rows
    # The checker's own words, quoted whole and indented: the only rows without a marker,
    # which is exactly what makes them recognisable as quotation.
    lines = [line for line in out.splitlines() if line.strip()]
    if not lines:
        # A checker that fails without saying anything still owes the reader a fact, and
        # its exit code is the only one this path has. Never print a header that promises
        # detail and then nothing — least of all on the broken host doctor exists for.
        rows.append((DOCTOR_PROBLEM, "sing-box check",
                     t("the checker reported an error, no message (exit {code})",
                       code=code)))
        return rows
    rows.append((DOCTOR_PROBLEM, "sing-box check", t("the checker reported an error:")))
    for line in lines[:DOCTOR_MSG_LINES]:
        rows.append((None, None, "    " + line))
    if len(lines) > DOCTOR_MSG_LINES:
        rows.append((None, None, "    " + t("... {n} more line(s) not shown",
                                            n=len(lines) - DOCTOR_MSG_LINES)))
    return rows


def _doctor_service():
    """S4 — running now, and registered to start at boot: two separate facts.

    The init-system check runs FIRST, so is_running()'s hard False on a host with neither
    systemd nor OpenRC is never rendered as "not running".

    Both facts are read from the init system rather than from settings["default_tun"]:
    that key records what `sc on/off` was last told to do, while the init system is the
    authority on what will actually happen at boot. A disagreement between them is itself
    a defect worth seeing, and only the authority can show it.
    """
    if not SYSTEMD and not OPENRC:
        cause = t("no init system detected (neither systemd nor OpenRC)")
        return [(DOCTOR_UNKNOWN, "service", cause),
                (DOCTOR_UNKNOWN, "boot autostart", cause)]
    init = "systemd" if SYSTEMD else "OpenRC"
    running = is_running()
    rows = [(DOCTOR_OK if running else DOCTOR_PROBLEM, "service",
             t("running (via {init})", init=init) if running
             else t("not running (via {init})", init=init))]
    try:
        if SYSTEMD:
            code, out = _doctor_run(["systemctl", "is-enabled", SERVICE])
            state = _first_line(out)
            enabled = (code == 0 and state == "enabled")
        else:
            _code, out = _doctor_run(["rc-update", "show", "default"])
            enabled = any(SERVICE in line.split() for line in out.splitlines())
            state = t("not in the default runlevel")
    except OSError as e:
        rows.append((DOCTOR_UNKNOWN, "boot autostart",
                     t("cannot determine: {e}", e=_plain(str(e)))))
        return rows
    if enabled:
        rows.append((DOCTOR_OK, "boot autostart", t("enabled")))
    else:
        rows.append((DOCTOR_PROBLEM, "boot autostart",
                     t("not enabled ({state})", state=_plain(state))))
    return rows


def _doctor_tun():
    """S5 — does this project's TUN device exist, and what addresses does it carry?

    `ip`'s operstate is deliberately not printed: for a TUN device it reads literally
    UNKNOWN and would collide with the outcome-class vocabulary.
    """
    try:
        code, out = _doctor_run(["ip", "-br", "addr", "show", TUN_IFACE])
    except OSError as e:
        return [(DOCTOR_UNKNOWN, "TUN interface",
                 t("cannot query: {e}", e=_plain(str(e))))]
    fields = []
    for line in out.splitlines():
        parts = line.split()
        if parts and parts[0].split("@")[0] == TUN_IFACE:
            fields = parts
            break
    if code != 0 or not fields:
        return [(DOCTOR_PROBLEM, "TUN interface",
                 t("{iface} does not exist", iface=TUN_IFACE))]
    addrs = fields[2:]      # name, operstate, then every address
    return [(DOCTOR_OK, "TUN interface", TUN_IFACE),
            (DOCTOR_OK if addrs else DOCTOR_PROBLEM, "TUN addresses",
             ", ".join(addrs) if addrs else t("(none)"))]


def _doctor_clash():
    """S6 — the persisted Clash API port, and whether it answers.

    The port comes from settings only. doctor never probes for a free port (that would
    report "unreachable" as a tautology) and never reads the module-level CLASH_PORT,
    which a doctor run deliberately leaves unresolved.
    """
    port = _saved_clash_port()
    if port is None:
        return [(DOCTOR_UNKNOWN, "Clash API", t("no port recorded in settings.json")),
                (DOCTOR_UNKNOWN, "Clash API responding", t("not probed — no port recorded"))]
    rows = [(DOCTOR_OK, "Clash API", "127.0.0.1:%d" % port)]
    answer = clash_api("GET", "/configs", port=port)
    # `is not None`: an empty body legitimately answers with {}, which is falsy.
    if answer is not None:
        rows.append((DOCTOR_OK, "Clash API responding", t("yes")))
    else:
        rows.append((DOCTOR_PROBLEM, "Clash API responding",
                     t("no answer within the 3s timeout")))
    return rows


def _doctor_egress():
    """S7 — the observed public egress address.

    Unconditional, unlike `sc status`: "the service is down and my egress IP is my ISP
    address" is a confirmation, not noise. Makes no claim about whether it is proxied.
    """
    try:
        return [(DOCTOR_OK, "egress IP", _plain(_egress_ip()))]
    except Exception as e:
        return [(DOCTOR_PROBLEM, "egress IP", t("(error: {e})", e=_plain(str(e))))]


# THE print order, and the only place it is decided: reading this tuple top to bottom is
# the review of the causal ordering. No probe prints another section's rows.
DOCTOR_SECTIONS = (
    ("sing-box binary", _doctor_binary),
    ("rule-sets", _doctor_rulesets),
    ("configuration", _doctor_config),
    ("service", _doctor_service),
    ("TUN interface", _doctor_tun),
    ("Clash API", _doctor_clash),
    ("egress IP", _doctor_egress),
)


def _doctor_print(cls, label, value):
    """One report row, flushed. `cls is None` prints a verbatim quoted line.

    The row shape — "[<class>] <label>: <value>" with the brackets and the ": " outside
    t() — is pinned here: it is what makes every row greppable and quotable on its own.
    No padding is computed anywhere, so zh's double-width text cannot misalign anything.
    """
    if cls is None:
        print(value, flush=True)
    else:
        print("[" + t(DOCTOR_MARK[cls]) + "] " + t(label) + ": " + value, flush=True)


def cmd_doctor(args):
    """The driver: per-section isolation, streaming, and the exit status."""
    worst = DOCTOR_OK
    for label_key, probe in DOCTOR_SECTIONS:
        try:
            rows = probe()
        except Exception as e:
            # `Exception`, never BaseException and never a bare except: KeyboardInterrupt
            # must still interrupt the 8 s egress wait. One failing probe costs its own
            # section's facts and nothing else — every label is still printed.
            rows = [(DOCTOR_UNKNOWN, None,
                     t("this check could not run: {e}", e=_plain(str(e))))]
        for cls, label, value in rows:
            # Flushed per row: without it the whole report would sit in the block buffer
            # when stdout is a pipe, which is precisely the bug-report case.
            _doctor_print(cls, label_key if label is None else label, value)
            if cls is not None:
                worst = max(worst, cls)
    sys.exit(DOCTOR_EXIT[worst])


def cmd_mode(args):
    mode = args.mode.lower()
    if mode not in ("rule", "global", "direct"):
        sys.exit(t("Error: mode must be one of rule / global / direct"))
    settings = load_settings()
    settings["mode"] = mode
    save_settings(settings)
    if is_running():
        clash_api("PATCH", "/configs", {"mode": mode})
    print(t("Route mode → {mode}", mode=mode))


def cmd_default_tun(args):
    val = args.value.lower()
    if val not in ("on", "off"):
        sys.exit(t("Error: argument must be on or off"))
    if val == "on":
        if SYSTEMD:
            subprocess.run(["systemctl", "enable", SERVICE], check=False)
        elif OPENRC:
            subprocess.run(["rc-update", "add", SERVICE, "default"], check=False)
    else:
        if SYSTEMD:
            subprocess.run(["systemctl", "disable", SERVICE], check=False)
        elif OPENRC:
            subprocess.run(["rc-update", "del", SERVICE, "default"], check=False)
    settings = load_settings()
    settings["default_tun"] = (val == "on")
    save_settings(settings)
    print(t("Boot autostart → {val}", val=val))


def cmd_sysproxy(args):
    val = args.value.lower()
    if val not in ("on", "off"):
        sys.exit(t("Error: argument must be on or off"))
    user = os.environ.get("SUDO_USER") or os.environ.get("USER")
    if not user:
        sys.exit(t("Error: cannot determine target user"))
    if val == "on":
        cmds = [
            ["gsettings", "set", "org.gnome.system.proxy", "mode", "manual"],
            ["gsettings", "set", "org.gnome.system.proxy.http", "host", "127.0.0.1"],
            ["gsettings", "set", "org.gnome.system.proxy.http", "port", "7890"],
            ["gsettings", "set", "org.gnome.system.proxy.https", "host", "127.0.0.1"],
            ["gsettings", "set", "org.gnome.system.proxy.https", "port", "7890"],
            ["gsettings", "set", "org.gnome.system.proxy.socks", "host", "127.0.0.1"],
            ["gsettings", "set", "org.gnome.system.proxy.socks", "port", "7890"],
        ]
    else:
        cmds = [["gsettings", "set", "org.gnome.system.proxy", "mode", "none"]]
    for c in cmds:
        subprocess.run(["sudo", "-u", user] + c, check=False)
    print(t("GNOME system proxy → {val}", val=val))


def cmd_update_rules(args):
    RULES_DIR.mkdir(parents=True, exist_ok=True)
    bases = _ruleset_bases(getattr(args, "mirror", None))
    tty = sys.stdout.isatty()
    before = ruleset_states()
    dead = set()        # a base that failed once is not retried in this run: with four
    failed = []         # bases the whole run still pays at most four timeouts, as today
    for fname, relpath in RULESET_FILES:
        target = RULES_DIR / fname
        tmp = _temp_path(fname)
        prefix = f"  ↓ {fname} ... "
        print(prefix, end="", flush=True)
        _clear_stale_temps(fname)
        # Two lists, deliberately: `causes` names EVERY base in list order (dead-skips
        # included) and feeds the total-failure line; `tried` names only the bases really
        # contacted and rejected for THIS file and is appended to the success line, so a
        # broken mirror stays visible when a later one works. Excluding dead-skips from
        # `tried` keeps one real cause per base per run and leaves the happy path (base 1
        # answers ⇒ `tried` empty ⇒ note empty) byte-identical.
        causes = []
        tried = []
        for base in bases:
            if base in dead:
                causes.append(base + " -> "
                              + t("skipped (this source already failed in this run)"))
                continue
            url = base.rstrip("/") + "/" + relpath
            try:
                got = _fetch_to_temp(url, tmp, prefix, tty)
                tmp.replace(target)     # atomic, and only after validation passed
                note = (t("; fell back after: {causes}", causes="; ".join(tried))
                        if tried else "")
                # ONE print, ONE completion line, no \r on the non-TTY path.
                print(t("OK ({size} bytes)", size=got) + note)
                break
            except Exception as e:
                dead.add(base)
                entry = base + " -> " + str(e)
                causes.append(entry)
                tried.append(entry)
                try:
                    tmp.unlink()        # never leave debris; the real path is untouched
                except OSError:
                    pass
        else:
            # Every base exhausted. The cause names each one, on stdout, one line.
            failed.append(fname)
            print(t("failed: {e}", e="; ".join(causes)))

    after = ruleset_states()
    gained = sorted(usable_tags(_status_view(after)) - usable_tags(_status_view(before)))
    changed = changed_usable_tags(before, after)    # gained is a subset of changed
    restarted = False
    # THE apply decision — one per run, for the whole run. `changed` is empty unless some
    # rule-set's installed BYTES really differ from what was on disk before the downloads,
    # so a run that re-fetched four byte-identical files touches nothing at all.
    # No config yet (fresh install) ⇒ do nothing: the installer generates the first one.
    if changed and CFG_PATH.exists():
        regen_ok = True
        if gained:
            # Recovery: regenerate (never patch) so the restored rule-sets are actually
            # used. Runs before the non-zero exit, so a partial recovery still repairs the
            # config, and a failed check still blocks the restart below.
            regen_ok = generate_config()
            print(t("Rule-sets restored: {names} — config regenerated", names=", ".join(gained)))
        if regen_ok and is_running():
            print("\n" + t("→ Restarting sing-box ..."))
            # The restart is conditional on changed_usable_tags(); an unconditional restart
            # here is the T-10 defect — it dropped every live connection (a remote admin's
            # own SSH included) on every weekly timer run, for four unchanged files.
            restart_service()
            restarted = True
    # Exactly one truthful run-level outcome, always, before the exit: a run that ends
    # non-zero must still state what it did to the service.
    if not changed:
        print(t("No rule-set changed — the sing-box service was not touched"))
    elif restarted:
        print(t("Rule-sets updated: {names} — sing-box restarted to load them",
                names=", ".join(changed)))
    else:
        print(t("Rule-sets updated: {names} — the sing-box service was not touched",
                names=", ".join(changed)))
    if failed:
        sys.exit("\n" + t("{n} ruleset(s) failed to update", n=len(failed)))
    print(t("Done"))

def cmd_update_interval(args):
    val = args.value.strip()

    if SYSTEMD:
        if val == "show":
            subprocess.run(
                ["systemctl", "list-timers", "--all",
                 "sing-box-rules-update.timer", "--no-pager"],
                check=False,
            )
            return

        presets = {"hourly": "hourly", "daily": "daily",
                   "weekly": "weekly", "monthly": "monthly"}
        if val.lower() in presets:
            on_calendar = presets[val.lower()]
        elif val.startswith("OnCalendar="):
            on_calendar = val[len("OnCalendar="):]
        else:
            on_calendar = val

        override_dir = Path("/etc/systemd/system/sing-box-rules-update.timer.d")
        override_dir.mkdir(parents=True, exist_ok=True)
        (override_dir / "override.conf").write_text(
            f"[Timer]\nOnCalendar=\nOnCalendar={on_calendar}\n"
        )

        subprocess.run(["systemctl", "daemon-reload"], check=False)
        r = subprocess.run(
            ["systemctl", "restart", "sing-box-rules-update.timer"],
            capture_output=True, text=True,
        )
        if r.returncode != 0:
            sys.exit(t("Error: applying timer failed: {err}", err=r.stderr.strip()))

        settings = load_settings()
        settings["update_interval"] = val
        save_settings(settings)

        print(t("Ruleset auto-update cadence → {val} (OnCalendar={oc})", val=val, oc=on_calendar))
        print("\n" + t("=== Next run ==="))
        subprocess.run(
            ["systemctl", "list-timers", "sing-box-rules-update.timer", "--no-pager"],
            check=False,
        )

    elif OPENRC:
        if val == "show":
            active = None
            for period, d in PERIODIC_DIRS.items():
                if (d / PERIODIC_SCRIPT).exists():
                    active = period
                    break
            if active:
                print(t("Ruleset auto-update: {period} (via /etc/periodic/{period}/)",
                        period=active))
            else:
                print(t("No automatic ruleset update configured. Run `sc update-interval daily|weekly|monthly` to set up."))
            return

        if val.lower() not in PERIODIC_DIRS:
            sys.exit(t("OpenRC only supports daily / weekly / monthly intervals. Use systemd for custom OnCalendar expressions."))

        # Remove from all period dirs first, then write to the chosen one
        for d in PERIODIC_DIRS.values():
            script = d / PERIODIC_SCRIPT
            if script.exists():
                script.unlink()
        target_dir = PERIODIC_DIRS[val.lower()]
        target_dir.mkdir(parents=True, exist_ok=True)
        script = target_dir / PERIODIC_SCRIPT
        script.write_text("#!/bin/sh\n/usr/local/bin/sc update-rules\n")
        script.chmod(0o755)

        settings = load_settings()
        settings["update_interval"] = val
        save_settings(settings)

        print(t("Ruleset auto-update cadence → {val} (OnCalendar={oc})", val=val, oc=val))
        print(t("Ruleset auto-update: {period} (via /etc/periodic/{period}/)", period=val.lower()))


def cmd_log(args):
    if SYSTEMD:
        if args.follow:
            subprocess.run(["journalctl", "-u", SERVICE, "-f"])
        else:
            subprocess.run(["journalctl", "-u", SERVICE, "-n", "100", "--no-pager"])
    else:
        # OpenRC: sing-box writes to /var/log/sing-box/ via supervise-daemon
        log_candidates = [
            Path("/var/log/sing-box/error.log"),
            Path("/var/log/sing-box/access.log"),
        ]
        log = next((p for p in log_candidates if p.exists()), log_candidates[0])
        if args.follow:
            subprocess.run(["tail", "-f", str(log)], check=False)
        else:
            subprocess.run(["tail", "-n", "100", str(log)], check=False)


def cmd_reload(args):
    if reload_or_restart():
        print(t("Reloaded"))
    else:
        sys.exit(t("Reload failed"))


def cmd_lang(args):
    val = args.value.lower()
    if val not in ("en", "zh"):
        sys.exit(t("Error: language must be 'en' or 'zh'"))
    settings = load_settings()
    settings["lang"] = val
    save_settings(settings)
    global LANG
    LANG = val
    print(t("Language → {val}", val=val))


def cmd_uninstall(args):
    script = LIB_DIR / "uninstall.sh"
    if script.exists():
        os.execvp("bash", ["bash", str(script)])
    sys.exit(t(
        "Uninstall script not found: {script}\n"
        "Use the one-line command to uninstall:\n"
        "  sudo bash -c \"$(curl -fsSL https://raw.githubusercontent.com/Alan-IFT/singbox-cli/main/uninstall.sh)\"",
        script=script,
    ))


HELP_EN = """sc — sing-box CLI manager

USAGE
  sc <command> [args]

COMMANDS
  ls                          List all nodes (● = currently active)
  now                         Show the currently active node
  use <name|index>            Switch active node (instant via Clash API, no restart)
  add <share-link>            Add a node from a share link
                              Supports vless / vmess / trojan / ss / hysteria2 / tuic
  rm <name|index>             Remove a node
  on                          Start sing-box and enable on boot
  off                         Stop sing-box and disable on boot
  status                      Show service status, TUN interface, active node, egress IP
  doctor                      Diagnose the install: seven read-only checks, causal order
                                changes nothing — no config, no download, no restart
                                exit 0 = every section OK
                                exit 1 = at least one PROBLEM
                                exit 2 = no PROBLEM, but at least one UNKNOWN
  mode <rule|global|direct>   Switch route mode (live)
                                rule   = rule-based routing (default)
                                global = everything via proxy
                                direct = everything direct
  default-tun <on|off>        Toggle boot autostart of sing-box independently
  sysproxy <on|off>           Toggle GNOME system proxy (HTTP/SOCKS 7890; usually unneeded with TUN)
  update-rules [--mirror URL] Update .srs rulesets now (several mirrors are tried in
                              order and every download is validated before install)
                                --mirror URL  use this base URL instead of the built-in
                                              mirror list; repeatable, and one value may
                                              hold several whitespace-separated URLs
                                env SB_RULES_BASE="<url> [url...]" does the same, but
                                  only when sc already runs as root (sudo's env_reset
                                  drops it otherwise) — prefer --mirror
  update-interval <freq|show>  Set the auto-update cadence
                                presets: hourly / daily / weekly / monthly
                                custom: any systemd OnCalendar expression
                                show: print current cadence and next run
  log [-f]                    Show logs (-f to follow, Ctrl+C to exit)
  reload                      Regenerate config and restart the service
  lang <en|zh>                Switch CLI language
  uninstall                   Uninstall singbox-cli (optionally remove the sing-box binary)
  help                        Show this help

EXAMPLES
  sc add 'vless://uuid@host:443?security=reality&pbk=...&sni=...&fp=chrome&flow=xtls-rprx-vision#LosAngeles-US'
  sc ls
  sc use US                   # or: sc use 1
  sc mode global
  sc update-interval daily             # update rulesets every day
  sc update-interval 'Mon *-*-* 04:00:00'   # every Monday at 04:00
  sc update-interval show              # show current cadence
  sc status

Hint: share links contain ? & # — wrap the entire link in single quotes
"""

HELP_ZH = """sc —— sing-box 命令行管理工具

用法
  sc <命令> [参数]

命令
  ls                          列出所有节点（● 表示当前激活）
  now                         显示当前激活节点
  use <名称|序号>             切换激活节点（通过 Clash API 即时生效，不重启）
  add <分享链接>              从分享链接添加节点
                              支持 vless / vmess / trojan / ss / hysteria2 / tuic
  rm <名称|序号>              删除节点
  on                          启动 sing-box 并设置开机自启
  off                         停止 sing-box 并取消开机自启
  status                      查看服务状态、TUN 接口、当前节点、出口 IP
  doctor                      一键体检：按因果顺序执行七项只读检查
                                全程只读 —— 不生成配置、不下载、不重启、不修复
                                退出码 0 = 七项全部正常
                                退出码 1 = 至少一项异常
                                退出码 2 = 没有异常，但至少一项未知
  mode <rule|global|direct>   切换路由模式（即时生效）
                                rule   = 按规则分流（默认）
                                global = 全部走代理
                                direct = 全部直连
  default-tun <on|off>        单独控制开机是否自启 sing-box
  sysproxy <on|off>           开关 GNOME 系统代理（HTTP/SOCKS 7890，TUN 模式下一般不用）
  update-rules [--mirror URL] 立即更新 .srs 规则集文件（按顺序尝试多个镜像，
                              每次下载都先校验再安装）
                                --mirror URL  用该基地址替代内置镜像列表；可重复出现，
                                              单个值也可写多个以空格分隔的 URL
                                环境变量 SB_RULES_BASE="<url> [url...]" 效果相同，但仅在
                                  sc 已以 root 运行时有效（否则会被 sudo 的 env_reset
                                  清除）—— 推荐用 --mirror
  update-interval <频率|show>  设置规则集自动更新频率
                                预设：hourly / daily / weekly / monthly
                                自定义：任意 systemd OnCalendar 表达式
                                show：查看当前频率和下次执行时间
  log [-f]                    查看日志（-f 实时跟随，Ctrl+C 退出）
  reload                      重新生成配置并重启服务
  lang <en|zh>                切换 CLI 语言
  uninstall                   卸载 singbox-cli（可选移除 sing-box 二进制）
  help                        显示本帮助

示例
  sc add 'vless://uuid@host:443?security=reality&pbk=...&sni=...&fp=chrome&flow=xtls-rprx-vision#美国洛杉矶'
  sc ls
  sc use 美国                 # 或 sc use 1
  sc mode global
  sc update-interval daily             # 改为每天更新规则集
  sc update-interval 'Mon *-*-* 04:00:00'   # 每周一凌晨 4 点
  sc update-interval show              # 查看当前频率
  sc status

提示：分享链接中含有 ? & # 等字符，整个链接必须用单引号包起来
"""


def cmd_help(args):
    print(HELP_ZH if LANG == "zh" else HELP_EN)


def main():
    global LANG, CLASH_PORT
    parser = argparse.ArgumentParser(prog="sc", add_help=False)
    sub = parser.add_subparsers(dest="cmd")
    sub.add_parser("ls"); sub.add_parser("now")
    p = sub.add_parser("use"); p.add_argument("spec")
    p = sub.add_parser("add"); p.add_argument("url", nargs="?")
    p = sub.add_parser("rm"); p.add_argument("spec")
    sub.add_parser("on"); sub.add_parser("off"); sub.add_parser("status")
    sub.add_parser("doctor")
    p = sub.add_parser("mode"); p.add_argument("mode")
    p = sub.add_parser("default-tun"); p.add_argument("value")
    p = sub.add_parser("sysproxy"); p.add_argument("value")
    p = sub.add_parser("update-rules")
    p.add_argument("--mirror", action="append", default=None)
    p = sub.add_parser("update-interval"); p.add_argument("value")
    p = sub.add_parser("log"); p.add_argument("-f", "--follow", action="store_true")
    sub.add_parser("reload"); sub.add_parser("uninstall")
    p = sub.add_parser("lang"); p.add_argument("value")
    sub.add_parser("help")

    args = parser.parse_args()
    # The start-up path WRITES: _init_files() creates /etc/sing-box, /etc/sing-box/rules
    # and /var/lib/sing-box and seeds nodes.json / settings.json, and _resolve_clash_port()
    # persists a freshly probed port on first run. `doctor` must reach neither: on a broken
    # or fresh host the emptiness of those very paths IS the diagnosis, and a diagnostic
    # that creates them destroys the evidence it was run to collect.
    # This is a positive opt-out naming ONE command: every other command — including every
    # command added later — takes the else arm with no action by anyone, so the failure
    # mode of forgetting this mechanism is "a new read-only command wrote files", never
    # "an existing command lost its initialisation".
    if args.cmd == "doctor":
        LANG = _load_lang()     # reads settings.json, tolerates its absence, writes nothing
    else:
        _init_files()
        LANG = _load_lang()
        CLASH_PORT = _resolve_clash_port()
    handlers = {
        "ls": cmd_ls, "now": cmd_now, "use": cmd_use, "add": cmd_add, "rm": cmd_rm,
        "on": cmd_on, "off": cmd_off, "status": cmd_status, "doctor": cmd_doctor,
        "mode": cmd_mode,
        "default-tun": cmd_default_tun, "sysproxy": cmd_sysproxy,
        "update-rules": cmd_update_rules, "update-interval": cmd_update_interval,
        "log": cmd_log, "reload": cmd_reload, "uninstall": cmd_uninstall,
        "lang": cmd_lang,
        "help": cmd_help, None: cmd_help,
    }
    handlers.get(args.cmd, cmd_help)(args)


if __name__ == "__main__":
    main()
