        "rule_set": [],     # placeholder — _runtime_overlay() $replaces it
        "final": "proxy",
    },
    "experimental": {
        "cache_file": {"enabled": True, "path": "/var/lib/sing-box/cache.db",
                       "store_fakeip": False},
        "clash_api": {"external_controller": ""},    # placeholder — set per run
